# Environment vars for Vision Hub services



# Local camera device (ex: /dev/video0, /dev/v4l/by-id/...)
CAMERA_DEVICE=/dev/video2
# Compression video format (e.g. mjpeg, yuyv, h264, ...) Prefer h264 if available
CAMERA_FORMAT=mjpeg
CAMERA_SIZE=1920x1080   
CAMERA_FPS=30
# `copy` for same format, `libx264` for h264
CAMERA_OUTPUT=libx264
# Stream URL for RTSP to be used by demos
RTSP_URL=rtsp://mediamtx:8554/cam


# YOLO model to use
MODEL=yolov8n.pt

# Input resolution for inference
IMG_SIZE_X=1280
IMG_SIZE_Y=720

# Detection thresholds
CONF=0.35
IOU=0.45
MAX_DET=100

# JPEG quality for MJPEG stream
JPEG_QUALITY=80

# Force CPU usage (1 = CPU, 0 = auto)
FORCE_CPU=0


# Consent management (used by API and Astro UI)
CONSENT_SECRET=wl6uuBc3L04cPvxrBKArKpf3ST2zZfq22iCHo1YrKYebCSH6D96lVZVvSES1y9Cw
CONSENT_TTL_SECONDS=600
CONSENT_AUD=vision-hub

# Contact information
CONTACT_NAME=Tom Burellier
CONTACT_EMAIL=tom.burellier@associated.ltu.se
