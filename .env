# Exemple de configuration pour Vision Hub

# Chemin de la caméra locale (pour le service capture)
CAMERA_DEVICE=/dev/video2
# Format de compression vidéo (ex: mjpeg, yuyv, h264, ...) Prioriser h264 si disponible
CAMERA_FORMAT=mjpeg
CAMERA_SIZE=1920x1080   
CAMERA_FPS=30
# copy pour même format, libx264 pour h264
CAMERA_OUTPUT=libx264

# URL du flux RTSP à utiliser par les démos
RTSP_URL=rtsp://mediamtx:8554/cam

# Modèle YOLO à utiliser
MODEL=yolov8n.pt

# Résolution d'entrée pour l'inférence
IMG_SIZE_X=1280
IMG_SIZE_Y=720

# Seuils de détection
CONF=0.35
IOU=0.45
MAX_DET=100

# Qualité JPEG pour le flux MJPEG
JPEG_QUALITY=80

# Forcer l'utilisation du CPU (1 = CPU, 0 = auto)
FORCE_CPU=0



