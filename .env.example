# Vision Hub - Network Configuration Example
# Copy this file to .env and adjust values for your deployment

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================
# Choose your networking approach by setting these variables appropriately:
# - Local development: Use localhost/127.0.0.1
# - Private network: Use 192.168.x.x or 10.x.x.x addresses
# - ZeroTier VPN: Use your ZeroTier network IP addresses
# - Public internet: Use your public IP addresses or domain names

# Frontend/Manager Node (where UI and MediaMTX run)
FRONTEND_HOST=localhost
FRONTEND_PORT=4321

# GPU Worker Node (where YOLO/Pose models run) - can be same as frontend for single-node
WORKER_HOST=localhost

# API/Orchestrator
API_HOST=localhost
API_PORT=8090

# MediaMTX Server
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HTTP_PORT=8889
MEDIAMTX_WEBRTC_PORT=8189

# Price Estimation API
PRICE_API_HOST=localhost
PRICE_API_PORT=8080

# YOLO Service
YOLO_HOST=localhost
YOLO_PORT=6000

# Pose Service
POSE_HOST=localhost
POSE_PORT=6001

# ==============================================================================
# CAMERA CONFIGURATION
# ==============================================================================
CAMERA_DEVICE=/dev/video0
CAMERA_FORMAT=mjpeg
CAMERA_FPS=30
CAMERA_SIZE=1280x720
CAMERA_OUTPUT=libx264

# RTSP Stream URL (internal Docker network)
RTSP_URL=rtsp://mediamtx:8554/cam

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================
MODEL=yolov8n.pt
MODEL_POSE=yolov8n-pose.pt
IMG_SIZE=640
JPEG_QUALITY=80
FORCE_CPU=0

# Detection thresholds
CONF=0.25
IOU=0.45
MAX_DET=300

# ==============================================================================
# ORCHESTRATOR CONFIGURATION
# ==============================================================================
ORCH_TOKEN=dev-token
IDLE_SECONDS=300

# Consent/Auth
CONSENT_SECRET=dev-consent-secret
CONSENT_TTL_SECONDS=600
CONSENT_AUD=vision-hub

# Capture container management
CAPTURE_NAME=vision-hub-capture
CAPTURE_IDLE_GRACE=180
CAPTURE_MIN_DOWN=20
CAPTURE_MIN_UP=60
CAPTURE_STARTUP_SETTLE=3

# ==============================================================================
# CONTACT INFORMATION
# ==============================================================================
CONTACT_NAME=Tom Burellier
CONTACT_EMAIL=tom.burellier@associated.ltu.se

# ==============================================================================
# ADVANCED CONFIGURATION
# ==============================================================================
# Docker Swarm stack name (for multi-node deployments)
STACK_NAME=vision-hub

# MediaMTX network interfaces (for WebRTC)
# Comma-separated list of network interface names
MEDIAMTX_INTERFACES=eno1,wlp1s0

# MediaMTX additional hosts (for WebRTC ICE candidates)
# Comma-separated list of IP addresses or hostnames
MEDIAMTX_ADDITIONAL_HOSTS=

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Automatically generated from host variables, but can be overridden
# Format: comma-separated list of allowed origins
# Example: http://localhost:4321,http://192.168.10.2:4321,https://mydomain.com
ALLOW_ORIGINS=

# Optional: Use regex for dynamic CORS
# Example: ^https?://(localhost|127\.0\.0\.1|192\.168\.10\.\d+):4321$
ALLOW_ORIGIN_REGEX=
