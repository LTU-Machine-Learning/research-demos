# UI Configuration
# These variables configure the Astro frontend
# Copy this to .env and adjust for your deployment

# WebRTC/WHEP endpoints for camera streams
# For local development:
PUBLIC_WHEP_CAM=http://localhost:8889/cam/whep

# For production/network deployment, use your actual hostname/IP:
# PUBLIC_WHEP_CAM=http://192.168.10.2:8889/cam/whep
# or with environment variable:
# PUBLIC_WHEP_CAM=http://${FRONTEND_HOST}:${MEDIAMTX_HTTP_PORT}/cam/whep

# MJPEG stream base URL
PUBLIC_MJPEG_BASE=http://localhost:8080/stream

# WebSocket for detection boxes (YOLO)
# For local development:
PUBLIC_BOXES_WS=ws://localhost:6002/ws/dets

# For production/network deployment:
# PUBLIC_BOXES_WS=ws://192.168.10.1:6002/ws/dets
# or:
# PUBLIC_BOXES_WS=ws://${WORKER_HOST}:${YOLO_PORT}/ws/dets

# API Base URL
# For local development:
VITE_API_BASE=http://localhost:8090

# For production/network deployment:
# VITE_API_BASE=http://192.168.10.2:8090
# or:
# VITE_API_BASE=http://${API_HOST}:${API_PORT}

# Worker (GPU) node where yolo/pose services run
# For single-node deployment, use localhost
VITE_YOLO_HOST=localhost
VITE_YOLO_PORT=6000
VITE_POSE_HOST=localhost
VITE_POSE_PORT=6001

# For multi-node deployment (e.g., ZeroTier, private network, public):
# VITE_YOLO_HOST=192.168.10.1
# VITE_POSE_HOST=192.168.10.1

# Frontend (manager) node where MediaMTX + UI run
# For single-node deployment, use localhost
VITE_FRONT_HOST=localhost
VITE_MTX_RTSP_PORT=8554
VITE_MTX_HTTP_PORT=8889

# For multi-node deployment:
# VITE_FRONT_HOST=192.168.10.2
