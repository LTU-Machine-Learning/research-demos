---
export interface Props {
  image: string;
  title: string;
  description: string;
  href: string;
}

const { image, title, description, href } = Astro.props;
---

<a href={href} class="proj-card" aria-label={`Open project ${title}`}>
  <div class="proj-card-image">
    <img src={image} alt={title} loading="lazy" />
  </div>

  <h2>{title}</h2>
  <p>{description}</p>
  <span class="proj-card-cta">See details & demo →</span>
</a>

<style>
  .proj-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #181c28;
    border-radius: 18px;
    padding: 22px 18px 18px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 24px #0004;
    transition: box-shadow .18s ease, transform .18s ease;
  }

  .proj-card:hover {
    box-shadow: 0 8px 32px #0007;
    transform: translateY(-4px) scale(1.02);
  }

  .proj-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #0f1422;
    margin-bottom: 12px;
  }

  .proj-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .25s ease;
  }

  .proj-card:hover .proj-card-image img {
    transform: scale(1.05);
  }

  .proj-card h2 {
    font-size: 1.25rem;
    margin: 8px 0 4px;
    color: #5aa4ff;
    text-align: center;
  }

  .proj-card p {
    font-size: 1rem;
    color: #b0bedc;
    text-align: center;
    margin-bottom: 10px;
  }

  .proj-card-cta {
    margin-top: auto;
    font-size: 1.08rem;
    font-weight: bold;
    color: #27d07d;
  }

  .proj-card:hover .proj-card-cta {
    color: #5aa4ff;
    text-decoration: underline;
  }
</style>
