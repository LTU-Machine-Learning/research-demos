---
export interface Props {
  title: string;
  videoId: string;
  fpsId: string;
  qualityId: string;
  stateId: string;
}
const { title, videoId, fpsId, qualityId, stateId } = Astro.props;
---
<div class="card">
  <h3 style="margin:6px 0 12px">{title}</h3>
  <video id={videoId} autoplay playsinline muted></video>
  <div class="kvs" style="margin-top:8px">
    <b>FPS</b><span id={fpsId}>—</span>
    <b>Qualité</b><span id={qualityId}>—</span>
    <b>État</b><span id={stateId}>—</span>
  </div>
</div>
