---
export interface Props {
  title?: string;
  description?: string;
}
const { title = 'Vision Hub – Welcome', description = 'Real-time AI demos' } = Astro.props;

// Topbar links
const links = [
  { href: '/',            label: 'Home' },
  { href: '/projects',    label: 'Projects' },
  { href: '/demo/yolo',   label: 'YOLO' },
  { href: '/demo/pose',   label: 'Pose' },
  { href: '/debug',       label: 'Debug' },
];

type CmdType = "project" | "demo" | "tool";

type Command = {
  type: CmdType;
  label: string;
  href: string;
  desc?: string;        // preview soft
  keywords?: string[];  // aide au search
};

const commands: Command[] = [
  // Projects (pages explicatives)
  { type: "project", label: "Object detection", href: "/project/yolo",
    desc: "YOLO-based real-time object detection pipeline.", keywords: ["yolo", "detection", "coco", "boxes"] },

  { type: "project", label: "Pose estimation", href: "/project/pose",
    desc: "YOLO-pose keypoints & real-time skeleton overlays.", keywords: ["pose", "keypoints", "skeleton", "yolo"] },

  { type: "project", label: "House price estimation", href: "/project/price",
    desc: "Predict housing prices with ML models & Swedish datasets.", keywords: ["price", "housing", "ml", "real estate"] },

  // Demos (lancement direct)
  { type: "demo", label: "Run: Object detection", href: "/demo/yolo",
    desc: "Launch the live detection demo.", keywords: ["run", "demo", "yolo", "detection"] },

  { type: "demo", label: "Run: Pose estimation", href: "/demo/pose",
    desc: "Launch the live pose demo.", keywords: ["run", "demo", "pose"] },

  { type: "demo", label: "Run: House price estimation", href: "/demo/price",
    desc: "Launch the pricing demo.", keywords: ["run", "demo", "price"] },

  // Tools
  { type: "tool", label: "Debug panel", href: "/debug",
    desc: "Diagnostics & integration checks.", keywords: ["debug", "tools", "health"] },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const year = new Date().getFullYear();
const brand = 'Vision Hub';
const ltuUrl = 'https://www.ltu.se/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/styles/app.css" />
    <slot name="head" />
    <style is:global>
      .topbar-inner {
        max-width: 1100px; margin: 0 auto; padding: 10px 16px;
        display: flex; gap: 12px; align-items: center; justify-content: space-between;
      }
      .brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--text); font-weight:700; }
      .badge { width:26px; height:26px; border-radius:8px;
        background: linear-gradient(135deg, var(--cta), var(--accent)); box-shadow: inset 0 0 12px #0006; }
      nav { display:flex; gap:6px; align-items:center; }  
      .nav-link:hover { opacity:1; background:#17203a; }
      .spacer { flex:1; }
      .pill { padding:6px 10px; border-radius:999px; font-size:12px; color:#cfe7ff;
        background:#122035; border:1px solid var(--border); }
      .page { max-width: 1100px; margin: 24px auto; padding: 0 16px 64px; }
      .burger{ display:none; background:none; border:none; color:var(--text); font-size:20px; }
      @media (max-width: 800px) { nav{ display:none; } .burger{ display:inline-flex; } }
      
      /* --- Nav layout --- */
      .main-nav { display:flex; gap:6px; align-items:center; }
      @media (max-width: 900px){ .main-nav { display:none; } }

      /* --- Search bar --- */
      .search-wrap{ position:relative; flex: 0 1 520px; margin: 0 10px; }
      @media (max-width: 900px){ .search-wrap{ flex:1; } }

      .search{
        display:flex; align-items:center; gap:10px;
        padding: 8px 10px;
        border-radius: 14px;
        background:#0f1422;
        border:1px solid #1f2a44;
        box-shadow: inset 0 0 0 1px #0000;
      }
      .search:focus-within{
        border-color:#5aa4ff;
        box-shadow: 0 0 0 3px #5aa4ff22;
      }
      .search-ico{ opacity:.8; }
      .search-input{
        width: 100%;
        background: transparent;
        border: 0;
        outline: none;
        color: var(--text);
        font-size: 0.95rem;
      }
      .search-kbd{
        font-size: 11px;
        padding: 3px 6px;
        border-radius: 8px;
        border: 1px solid #1f2a44;
        background: #122035;
        color: #cfe7ff;
        opacity: .85;
      }

      /* --- Results dropdown --- */
      .results{
        display:none;
        position:absolute;
        top: calc(100% + 10px);
        left:0;
        right:0;
        background:#0f1422;
        border:1px solid #1f2a44;
        border-radius: 16px;
        overflow:hidden;
        box-shadow: 0 24px 80px #000a;
        z-index: 60;
      }
      .results.open{ display:block; }
      .results .section{
        padding: 10px 12px 6px;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
        color:#9cb0d8;
        border-top: 1px solid #15223b;
      }
      .results .item{
        display:flex;
        gap:10px;
        padding:10px 12px;
        align-items:flex-start;
        cursor:pointer;
      }
      .results .item:hover,
      .results .item.active{
        background:#132342;
      }
      .results .tag{
        min-width: 56px;
        font-size: 11px;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 999px;
        border: 1px solid #1f2a44;
        background:#122035;
        color:#cfe7ff;
        text-transform: uppercase;
        letter-spacing: .04em;
      }
      .results .tag.demo{ color:#27d07d; border-color:#27d07d66; background:#0f1e1a; }
      .results .tag.tool{ color:#ffce5a; border-color:#ffce5a66; background:#201a0f; }

      .results .meta{ display:flex; flex-direction:column; gap:2px; }
      .results .label{ color:#e8eefc; font-weight:700; }
      .results .desc{ color:#9cb0d8; font-size: 12.5px; line-height: 1.25; }
      .results .href{ color:#6f88b8; font-size: 12px; opacity:.9; }

      /* --- Debug button distinct --- */
      .debug-btn{
        display:inline-flex; align-items:center; gap:8px;
        padding: 7px 11px;
        border-radius: 12px;
        text-decoration:none;
        font-weight: 800;
        border:1px solid #1f2a44;
        background:#151018;
        color:#ffce5a;
      }
      .debug-btn:hover{ background:#1b1523; border-color:#ffce5a66; }

      /* === HEADER LAYOUT === */
      .vh-header{
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 32px;
        min-height: 64px;
      }

      /* LEFT */
      .vh-left{
        display:flex;
        align-items:center;
        white-space: nowrap;
      }

      /* CENTER */
      .vh-center{
        display:flex;
        align-items:center;
        justify-content:center;
        gap: 24px;
        min-width: 0; /* IMPORTANT pour éviter les wraps */
      }

      /* RIGHT */
      .vh-right{
        display:flex;
        align-items:center;
        white-space: nowrap;
      }

      /* Prevent wrapping everywhere */
      .brand,
      .main-nav,
      .search-wrap,
      .debug-btn{
        white-space: nowrap;
      }

      /* ===== Footer ===== */
      .vh-footer{
        margin-top: 24px;
        background: #0f1422;
        border-top: 1px solid #1f2a44;
        color: #b8c7ea;
      }
      .vh-footer .vh-wrap{
        max-width: 1100px;
        margin: 0 auto;
        padding: 18px 16px;
        display: flex;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
      }
      .vh-footer .vh-left{ display:flex; flex-direction:column; gap:4px; }
      .vh-footer .vh-brand{ font-weight:600; color:#e8eefc; }
      .vh-footer .vh-byline a{ color:#5aa4ff; text-decoration:none; }
      .vh-footer .vh-byline a:hover{ text-decoration:underline; color:#27d07d; }
      .vh-footer .vh-right{ display:flex; gap:16px; align-items:center; }
      .vh-footer .vh-right a{
        color:#9cb0d8; text-decoration:none; font-weight:600; font-size:.95rem;
        border:1px solid transparent; padding:6px 10px; border-radius:10px;
      }
      .vh-footer .vh-right a:hover{ color:#27d07d; background:#132342; border-color:#1f2a44; }
      @media (max-width: 640px){
        .vh-footer .vh-right{ width:100%; justify-content:flex-start; flex-wrap:wrap; gap:10px; }
      }
    </style>
    <script type="module">
      const initMenu = () => {
        const btn = document.querySelector('[data-burger]');
        const nav = document.querySelector('[data-nav]');
        if (!btn || !nav) return;
        btn.addEventListener('click', () => {
          const open = nav.style.display === 'flex';
          nav.style.display = open ? 'none' : 'flex';
          nav.style.flexDirection = 'column';
          nav.style.position = 'absolute';
          nav.style.top = '56px';
          nav.style.left = '0';
          nav.style.right = '0';
          nav.style.background = 'linear-gradient(180deg, var(--bg-top), var(--bg-bottom))';
          nav.style.padding = '8px';
          nav.style.borderBottom = '1px solid var(--border)';
        });
      };
      addEventListener('DOMContentLoaded', initMenu);
    </script>
    <script>
      const hd = new Image();
      hd.src = "/images/LTU_BG_2.JPG";
      hd.decode ? hd.decode().then(done).catch(()=>hd.onload=done) : (hd.onload = done);
      function done(){ document.body.classList.add('ready'); }

      const io = new IntersectionObserver((entries)=>{
        for (const e of entries) if (e.isIntersecting) {
          e.target.classList.add('in'); io.unobserve(e.target);
        }
      }, { rootMargin: "0px 0px -10% 0px", threshold: .05 });

      document.querySelectorAll('.hero, .projects-preview, .proj-card').forEach(el=>{
        el.classList.add('reveal'); io.observe(el);
      });
    </script>
    <script type="module" define:vars={{ commands }}>
      const input = document.getElementById("vh-search");
      const results = document.getElementById("vh-results");

      let activeIndex = -1;
      let flat = [];

      const typeLabel = (t) => t === "project" ? "Project" : (t === "demo" ? "Demo" : "Tool");
      const typeClass = (t) => t;

      const normalize = (s) => (s || "").toLowerCase().trim();

      function score(cmd, q){
        if (!q) return 1;
        const hay = [
          cmd.label,
          cmd.href,
          ...(cmd.keywords || []),
          cmd.desc || ""
        ].join(" ").toLowerCase();
        if (hay.includes(q)) return 10;
        // mini scoring: match by words
        const parts = q.split(/\s+/).filter(Boolean);
        let hits = 0;
        for (const p of parts) if (hay.includes(p)) hits++;
        return hits;
      }

      function groupByType(cmds){
        const g = { project: [], demo: [], tool: [] };
        for (const c of cmds) g[c.type].push(c);
        return g;
      }

      function render(q){
        const qq = normalize(q);
        const ranked = commands
          .map(c => ({ c, s: score(c, qq) }))
          .filter(x => x.s > 0)
          .sort((a,b)=> b.s - a.s)
          .map(x => x.c)
          .slice(0, 12);

        const g = groupByType(ranked);
        flat = [];

        const sections = [
          ["Projects", g.project],
          ["Demos", g.demo],
          ["Tools", g.tool],
        ].filter(([,arr]) => arr.length);

        if (!sections.length){
          results.innerHTML = `<div class="section">No results</div>`;
          results.classList.add("open");
          activeIndex = -1;
          return;
        }

        let html = "";
        for (const [title, arr] of sections){
          html += `<div class="section">${title}</div>`;
          for (const cmd of arr){
            flat.push(cmd);
            html += `
              <div class="item" data-href="${cmd.href}">
                <div class="tag ${typeClass(cmd.type)}">${typeLabel(cmd.type)}</div>
                <div class="meta">
                  <div class="label">${cmd.label}</div>
                  ${cmd.desc ? `<div class="desc">${cmd.desc}</div>` : ""}
                  <div class="href">${cmd.href}</div>
                </div>
              </div>`;
          }
        }
        results.innerHTML = html;
        results.classList.add("open");
        setActive(0);
      }

      function setActive(i){
        const items = results.querySelectorAll(".item");
        items.forEach(el => el.classList.remove("active"));
        if (!items.length) { activeIndex = -1; return; }
        activeIndex = Math.max(0, Math.min(i, items.length - 1));
        items[activeIndex].classList.add("active");
      }

      function close(){
        results.classList.remove("open");
        activeIndex = -1;
      }

      // Input events
      input.addEventListener("input", () => render(input.value));
      input.addEventListener("focus", () => render(input.value));

      // Click on item
      results.addEventListener("mousedown", (e) => {
        const item = e.target.closest(".item");
        if (!item) return;
        const href = item.getAttribute("data-href");
        if (href) location.href = href;
      });

      // Keyboard nav
      input.addEventListener("keydown", (e) => {
        if (!results.classList.contains("open") && (e.key === "ArrowDown" || e.key === "Enter")){
          render(input.value);
          e.preventDefault();
          return;
        }
        if (e.key === "ArrowDown"){ setActive(activeIndex + 1); e.preventDefault(); }
        if (e.key === "ArrowUp"){ setActive(activeIndex - 1); e.preventDefault(); }
        if (e.key === "Escape"){ close(); }
        if (e.key === "Enter"){
          const cmd = flat[activeIndex];
          if (cmd?.href) location.href = cmd.href;
        }
      });

      // Ctrl/⌘K focus
      addEventListener("keydown", (e) => {
        const isK = (e.key || "").toLowerCase() === "k";
        if ((e.ctrlKey || e.metaKey) && isK){
          e.preventDefault();
          input.focus();
          input.select?.();
          render(input.value);
        }
        if (e.key === "Escape" && document.activeElement === input){
          close();
          input.blur();
        }
      });

      // Click outside closes
      document.addEventListener("mousedown", (e) => {
        if (e.target.closest(".search-wrap")) return;
        close();
      });
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="Vision Hub home">
          <img src="/images/LTU_logo.png" alt="" class="brand-logo" width="24" height="24" />
          <span>Vision Hub</span>
        </a>

          <nav data-nav class="main-nav" aria-label="Main">
            <a href="/" class={`nav-link ${isActive("/") ? "active" : ""}`}>Home</a>
            <a href="/projects" class={`nav-link ${isActive("/projects") ? "active" : ""}`}>Projects</a>
            <a href="/docs" class={`nav-link ${isActive("/docs") ? "active" : ""}`}>Documentation</a>
          </nav>

          <div class="search-wrap" role="search">
            <div class="search">
              <span class="search-ico" aria-hidden="true">⌕</span>
              <input
                id="vh-search"
                class="search-input"
                type="search"
                placeholder="Search projects, demos, tools… (Ctrl/⌘ K)"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search and launch"
              />
              <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
            </div>

            <div id="vh-results" class="results" role="listbox" aria-label="Search results"></div>
          </div>

          <div class="spacer"></div>

          <a class="debug-btn" href="/debug" aria-label="Open debug panel">
            🛠 Debug
          </a>

          <button class="burger" data-burger aria-label="Menu">☰</button>
      </div>
    </header>
    <header class="topbar">
      <div class="topbar-inner vh-header">
        
        <!-- LEFT -->
        <div class="vh-left">
          <a class="brand" href="/">
            <img src="/images/LTU_logo.png" alt="" width="24" height="24" />
            <span>Vision Hub</span>
          </a>
        </div>

        <!-- CENTER -->
        <div class="vh-center">
          <nav class="main-nav">
            <a href="/" class="nav-link active">Home</a>
            <a href="/projects" class="nav-link">Projects</a>
            <a href="/docs" class="nav-link">Documentation</a>
          </nav>

          <div class="search-wrap" role="search">
            <div class="search">
              <span class="search-ico" aria-hidden="true">⌕</span>
              <input
                id="vh-search"
                class="search-input"
                type="search"
                placeholder="Search projects, demos, tools… (Ctrl/⌘ K)"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search and launch"
              />
              <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
            </div>

            <div id="vh-results" class="results" role="listbox" aria-label="Search results"></div>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="vh-right">
          <a class="debug-btn" href="/debug">🛠 Debug</a>
        </div>

      </div>
    </header>

    {/* SCÈNE d’arrière-plan (blobs animés) */}
    <div class="scene" aria-hidden="true">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <div class="blob b3"></div>
    </div>

    <main class="page">
      <slot />
    </main>

    {/* ===== Footer ===== */}
    <footer class="vh-footer" role="contentinfo">
      <div class="vh-wrap">
        <div class="vh-left">
          <div class="vh-brand">© {year} {brand} — All rights reserved</div>
          <div class="vh-byline">
            Developed with <span aria-label="love">❤️</span> by
            {' '}
            <a href={ltuUrl} target="_blank" rel="noopener noreferrer">balmine</a>
            {' '}
            for Luleå University of Technology
          </div>
        </div>
        <nav class="vh-right" aria-label="Footer">
          <a href="/privacy">Privacy</a>
          <a href="/contact">Contact</a>
          <a href="/projects">Projects</a>
          <a href={ltuUrl} target="_blank" rel="noopener noreferrer">LTU's website</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
