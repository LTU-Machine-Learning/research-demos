---
const TITLE = 'Vision Hub - Démos';
const NOTE  = 'Aperçu faible latence (WebRTC) – cam & annot + compteur FPS.';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{TITLE}</title>
    <style>
      :root{ --bg:#0b0d12; --card:#11151c; --ink:#e8eefc; --muted:#91a0b6; --pri:#5aa4ff; --ok:#27d07d; --warn:#ffb000; --br:16px }
      *{box-sizing:border-box}
      body{margin:0;background:linear-gradient(180deg,#0b0d12,#0f1320);color:var(--ink);font:15px/1.5 system-ui,Segoe UI,Roboto,Arial}
      .wrap{max-width:1200px;margin:24px auto;padding:0 16px}
      h1{font-size:24px;margin:8px 0 4px}
      p.sub{color:var(--muted);margin:0 0 16px}
      .grid{display:grid;gap:16px;grid-template-columns:1fr;align-items:start}
      @media(min-width:1100px){ .grid{grid-template-columns:1fr 1fr} }
      .card{background:var(--card);border:1px solid #1c2230;border-radius:var(--br);padding:14px;box-shadow:0 6px 24px rgba(0,0,0,.25)}
      .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
      button{background:#132342;color:var(--ink);border:1px solid #25406e;border-radius:12px;padding:8px 12px;cursor:pointer}
      button.primary{background:var(--pri);border-color:#4a8ee0;color:#081120;font-weight:700}
      button.ghost{background:transparent;border:1px dashed #2a3550}
      .stat{font-variant-numeric:tabular-nums;color:var(--muted)}
      video{
        border:1px solid #202940;border-radius:12px;background:#000;
        width:100%;max-width:640px;height:360px;object-fit:contain;display:block;margin:0 auto;
      }
      .title{display:flex;justify-content:space-between;align-items:center;gap:8px}
      .kvs{display:grid;grid-template-columns:auto 1fr;gap:6px 10px;font-size:13px;color:#cbd7ef}
      .kvs b{color:#9fb3d6}
    </style>
  </head>

  <body>
    <div class="wrap">
      <div class="title">
        <div>
          <h1>{TITLE}</h1>
          <p class="sub">{NOTE}</p>
        </div>
        <div class="row">
          <button id="start" class="primary">Start</button>
          <button id="stop"  class="ghost">Stop</button>
        </div>
      </div>

      <div class="grid">
        <div class="card">
          <h3 style="margin:6px 0 12px">Preview (WebRTC – cam)</h3>
          <video id="webrtc"   autoplay playsinline muted></video>
          <div class="kvs" style="margin-top:8px">
            <b>FPS cam</b><span id="fpsCam">—</span>
            <b>Qualité</b><span id="qCam">—</span>
            <b>État</b><span id="rtcCam">—</span>
          </div>
        </div>

        <div class="card">
          <h3 style="margin:6px 0 12px">Annotation (WebRTC – annot)</h3>
          <video id="annotRtc" autoplay playsinline muted></video>
          <div class="kvs" style="margin-top:8px">
            <b>FPS annot</b><span id="fpsAnnot">—</span>
            <b>Qualité</b><span id="qAnnot">—</span>
            <b>État</b><span id="rtcAnnot">—</span>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:16px">
        <h3 style="margin:6px 0 12px">Endpoints</h3>
        <div class="kvs">
          <b>WHEP cam</b><span id="epCam">—</span>
          <b>WHEP annot</b><span id="epAnnot">—</span>
          <b>Tips</b><span>Ouvre 8889/TCP et 8189/UDP (ICE) sur le conteneur MediaMTX. Même schéma (http/https) que la page.</span>
        </div>
      </div>
    
      <div class="card">
        <h3 style="margin:6px 0 12px">Cam (Overlay client – WebRTC + canvas)</h3>
        <div class="stack">
          <video id="camOverlay" autoplay playsinline muted></video>
          <canvas id="ovl"></canvas>
        </div>
        <div class="kvs" style="margin-top:8px">
          <b>Qualité</b><span id="qOverlay">—</span>
        </div>
      </div>
    </div>


    <style>
      .stack{
        position:relative;
        width:100%;
        max-width:640px;
        margin:0 auto;
        aspect-ratio: 16 / 9;          /* maintient 16:9 responsive */
      }
      .stack > video,
      .stack > canvas{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit: contain;
        border:1px solid #202940;
        border-radius:12px;
      }
      .stack > video{
        background:#000;               /* la vidéo a le fond noir */
        z-index:1;
      }
      .stack > canvas{
        background:transparent;        /* canvas transparent ! */
        pointer-events:none;           /* ne mange pas les clics */
        z-index:2;
      }
    </style>
      
    
    



    <script type="module">
      // ===== UTIL LOG (console + <pre id="log"> si présent) =====
      const logBox = document.getElementById('log');
      const log = (...args) => {
        console.log(...args);
        if (logBox) {
          logBox.textContent += args.map(a => (typeof a === 'object' ? JSON.stringify(a) : String(a))).join(' ') + '\n';
          logBox.scrollTop = logBox.scrollHeight;
        }
      };

      // ===== DOM =====
      const $ = (id) => document.getElementById(id);
      const videoCam   = $('webrtc');
      const videoAnnot = $('annotRtc');
      const startBtn   = $('start');
      const stopBtn    = $('stop');

      const fpsCamEl = $('fpsCam');
      const fpsAnEl  = $('fpsAnnot');
      const stCamEl  = $('rtcCam');
      const stAnEl   = $('rtcAnnot');

      // Endpoints
      const base       = `${location.protocol}//${location.hostname}:8889`;
      const WHEP_CAM   = `${base}/cam/whep`;
      const WHEP_ANNOT = `${base}/annot/whep`;
      const epCamEl    = $('epCam');
      const epAnnotEl  = $('epAnnot');
      const qCamEl = $('qCam');
      const qAnEl  = $('qAnnot');

      if (epCamEl)   epCamEl.textContent   = WHEP_CAM;
      if (epAnnotEl) epAnnotEl.textContent = WHEP_ANNOT;

      // ===== STATE =====
      let pcCam = null, pcAnnot = null;
      let getCamFn = null, getAnnotFn = null;
      let lagTimer = null;
      const lagTracker = makeLagTracker();

      const videoOverlay = document.getElementById('camOverlay');
      const canvas = document.getElementById('ovl');
      const ctx = canvas.getContext('2d');
      const qOverlayEl = document.getElementById('qOverlay');

      // ===== FPS METERS =====
      function startFpsMeters(videoEl, label, onFps, pc) {
        // --- instrumentation utile
        const log = (...a) => console.log(`[${label}]`, ...a);
        videoEl.addEventListener('loadedmetadata', () => log('loadedmetadata', videoEl.videoWidth, 'x', videoEl.videoHeight));
        videoEl.addEventListener('playing',        () => log('playing'));
        videoEl.addEventListener('resize',         () => log('resize', videoEl.videoWidth, 'x', videoEl.videoHeight));

        // On normalise l’update FPS
        let lastUpdate = 0;
        const updateFps = (fps, src) => {
          if (!fps || !isFinite(fps)) return;
          onFps(String(Number(fps).toFixed(1)));
          lastUpdate = performance.now();
          // log(`FPS=${Number(fps).toFixed(1)} via ${src}`);
        };

        // 1) rVFC (si dispo) — on NE désactive plus les fallbacks
        if ('requestVideoFrameCallback' in HTMLVideoElement.prototype) {
          log('rVFC supporté ✔');
          let lastMediaTime = null;
          const samples = [];
          const rvfc = (_now, meta) => {
            const mt = meta?.mediaTime;
            if (typeof mt === 'number') {
              if (lastMediaTime != null) {
                const dt = mt - lastMediaTime; // secondes
                if (dt > 0 && dt < 1.0) {
                  const inst = 1 / dt;
                  samples.push(inst);
                  if (samples.length > 30) samples.shift();
                  const avg = samples.reduce((a,b)=>a+b,0) / samples.length;
                  updateFps(avg, 'rVFC');
                }
              }
              lastMediaTime = mt;
            }
            videoEl.requestVideoFrameCallback(rvfc);
          };
          const kick = () => {
            try { videoEl.requestVideoFrameCallback(rvfc); log('rVFC démarré'); } catch(e){ log('rVFC err', e.message); }
          };
          if (videoEl.readyState >= 2) kick();
          videoEl.addEventListener('playing', kick, { once:true });
        } else {
          log('rVFC non supporté → fallbacks');
        }

        // 2) PlaybackQuality (si dispo) — tourne en parallèle
        if (typeof videoEl.getVideoPlaybackQuality === 'function') {
          log('getVideoPlaybackQuality() actif');
          let lastT = performance.now();
          let lastF = 0;
          setInterval(() => {
            const q = videoEl.getVideoPlaybackQuality();
            const now = performance.now();
            const dt  = (now - lastT) / 1000;
            if (q && typeof q.totalVideoFrames === 'number') {
              const df = q.totalVideoFrames - lastF;
              if (dt > 0 && df >= 0) updateFps(df / dt, 'playbackQuality');
              lastF = q.totalVideoFrames;
              lastT = now;
            }
          }, 1000);
        }

        // 3) WebRTC getStats — tourne en parallèle aussi
        if (pc) {
          let pickedKey = null;
          let lastWall = performance.now();
          let lastFrames = 0;

          const loop = async () => {
            if (!pc || pc.connectionState === 'closed') return;
            try {
              const stats = await pc.getStats();

              // --- retire/neutralise le log qui utilisait whepUrl ---
              // stats.forEach(s => { ... });

              // rtp inbound vidéo
              let rtp = null;
              stats.forEach(r => { if (r.type === 'inbound-rtp' && r.kind === 'video') rtp = r; });
              if (rtp) {
                if (!pickedKey) {
                  if (typeof rtp.framesPerSecond === 'number') pickedKey = 'framesPerSecond';
                  else if (typeof rtp.framesDecoded === 'number') pickedKey = 'framesDecoded';
                  else if (typeof rtp.framesReceived === 'number') pickedKey = 'framesReceived';
                  log('getStats clé:', pickedKey || 'aucune');
                }
                const now = performance.now();
                const dt  = (now - lastWall) / 1000;
                if (pickedKey === 'framesPerSecond' && typeof rtp.framesPerSecond === 'number') {
                  updateFps(rtp.framesPerSecond, 'getStats(fps)');
                } else {
                  const f = rtp[pickedKey ?? 'framesDecoded'];
                  if (typeof f === 'number' && dt > 0) {
                    updateFps((f - lastFrames) / dt, 'getStats');
                    lastFrames = f; lastWall = now;
                  }
                }
              }
            } catch { /* silencieux */ }
            setTimeout(loop, 1000);
          };
          loop();
        }

        // 4) Watchdog : si aucune update en 3 s, on le dit
        setInterval(() => {
          if (performance.now() - lastUpdate > 3000) {
            // log('pas d’update FPS depuis 3s');
            // Option : afficher un tiret spécial, mais on laisse le dernier nombre si dispo
          }
        }, 1500);
      }

      // ===== WHEP PLAYER =====
      async function playWHEP(whepUrl, videoEl, stEl, fpsEl) {
        stEl.textContent = 'init';
        const pc = new RTCPeerConnection({
          iceServers: [{ urls: ['stun:stun.l.google.com:19302'] }]
        });

        pc.onicegatheringstatechange = () => log(`[${whepUrl}] iceGathering: ${pc.iceGatheringState}`);
        pc.oniceconnectionstatechange = () => log(`[${whepUrl}] ice: ${pc.iceConnectionState}`);
        pc.onsignalingstatechange = () => log(`[${whepUrl}] signaling: ${pc.signalingState}`);
        pc.onconnectionstatechange = () => {
          stEl.textContent = pc.connectionState;
          log(`[${whepUrl}] connection: ${pc.connectionState}`);
        };

        const trans = pc.addTransceiver('video', { direction: 'recvonly' });

        pc.ontrack = (ev) => {
          log(`[${whepUrl}] ontrack (stream)`);
          videoEl.srcObject = ev.streams[0];
          // petit kick pour autoplay
          videoEl.play?.().catch(()=>{});
        };

        // Négociation WHEP
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        log(`[${whepUrl}] POST offer`);
        const res = await fetch(whepUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/sdp' },
          body: offer.sdp
        });
        if (!res.ok) throw new Error(`WHEP ${res.status} @ ${whepUrl}`);
        const answer = await res.text();
        await pc.setRemoteDescription({ type: 'answer', sdp: answer });
        log(`[${whepUrl}] answer OK`);

        // FPS attach
        startFpsMeters(videoEl, whepUrl, (fps) => { fpsEl.textContent = fps; }, pc);
        return pc;
      }

      // ===== START/STOP =====
      async function start() {
        // Si déjà en cours → on repart propre
        if (pcCam || pcAnnot) stop();

        // Reset visuel
        stCamEl.textContent = 'init';
        stAnEl.textContent  = 'init';
        qCamEl.textContent  = '—';
        qAnEl.textContent   = '—';
        fpsCamEl.textContent = '—';
        fpsAnEl.textContent  = '—';

        try {
          // 1) Démarre les deux flux WebRTC (WHEP)
          pcCam   = await playWHEP(WHEP_CAM,   videoCam,   stCamEl, fpsCamEl);
          watchQuality(pcCam,   'cam',   qCamEl);

          pcAnnot = await playWHEP(WHEP_ANNOT, videoAnnot, stAnEl,  fpsAnEl);
          watchQuality(pcAnnot, 'annot', qAnEl);

          // 2) Attends que les <video> jouent (frames réelles disponibles)
          await Promise.all([waitPlaying(videoCam), waitPlaying(videoAnnot)]);

          // 3) Instancie les samplers (une seule fois)
          if (!getCamFn)   getCamFn   = makeSampler(videoCam);
          if (!getAnnotFn) getAnnotFn = makeSampler(videoAnnot);

          // 4) Lance/relance le timer d’estimation de latence cam→annot
          if (lagTimer) { clearInterval(lagTimer); lagTimer = null; }
          lagTimer = setInterval(() => {
            const est = lagTracker.estimate(getCamFn, getAnnotFn); // { lag, confidence, score } ou null
            if (est) {
              const ms = Math.round(est.lag);
              const conf = (est.confidence * 100) | 0;
              qAnEl.textContent = `Δ ~ ${ms} ms • conf ${conf}%`;
            }
          }, 500);

          // === 5) Overlay client (3e visuel) : même stream que "cam" + boxes via WS ===
          const videoOverlay = document.getElementById('camOverlay');
          const canvas = document.getElementById('ovl');
          const ctx = canvas.getContext('2d');

          // après avoir lancé pcCam et quand videoCam joue :
          await waitPlaying(videoCam);
          if (videoOverlay) {
            videoOverlay.srcObject = videoCam.srcObject; // même MediaStream
            videoOverlay.play?.().catch(()=>{});
          }

          // Reçoit les détections (WS YOLO)
          const wsProto = (location.protocol === 'https:') ? 'wss' : 'ws';
          const ws = new WebSocket(`${wsProto}://${location.hostname}:5000/ws/dets`);
          let lastDet = null;
          ws.onmessage = (e) => { try { lastDet = JSON.parse(e.data); } catch {} };

          // Dessine l’overlay synchronisé aux frames vidéo
          function drawOverlay() {
            if (!canvas || !ctx || !videoOverlay) return;

            const cw = canvas.width  = canvas.clientWidth;
            const ch = canvas.height = canvas.clientHeight;
            ctx.clearRect(0,0,cw,ch);

            if (lastDet && videoOverlay.videoWidth && videoOverlay.videoHeight) {
              const vw = videoOverlay.videoWidth, vh = videoOverlay.videoHeight;

              // letterbox "contain"
              const r  = Math.min(cw/vw, ch/vh);
              const dw = vw*r, dh = vh*r;
              const dx = (cw-dw)/2, dy = (ch-dh)/2;
              const sx = dw/lastDet.w, sy = dh/lastDet.h;

              ctx.lineWidth = 2;
              ctx.font = '12px system-ui';

              for (const b of (lastDet.boxes || [])) {
                const x = dx + b.x1*sx, y = dy + b.y1*sy;
                const w = (b.x2-b.x1)*sx, h = (b.y2-b.y1)*sy;
                ctx.strokeStyle = 'rgba(0,255,0,0.95)';
                ctx.strokeRect(x,y,w,h);
                if (b.conf != null) {
                  const label = `${b.cls ?? ''} ${(b.conf*100).toFixed(0)}%`;
                  const pad = 3, tw = ctx.measureText(label).width;
                  ctx.fillStyle = 'rgba(0,0,0,0.6)';
                  ctx.fillRect(x, y-16, tw+pad*2, 16);
                  ctx.fillStyle = '#00ff00';
                  ctx.fillText(label, x+pad, y-4);
                }
              }
            }

            // enchaîne sur la prochaine frame affichée
            if ('requestVideoFrameCallback' in HTMLVideoElement.prototype) {
              videoOverlay.requestVideoFrameCallback(() => drawOverlay());
            } else {
              requestAnimationFrame(drawOverlay);
            }
          }

          if (videoOverlay?.readyState >= 2) drawOverlay();
          else videoOverlay?.addEventListener('loadedmetadata', drawOverlay, { once:true });

        } catch (e) {
          console.error('WHEP/start error:', e);
          stCamEl.textContent = 'error';
          stAnEl.textContent  = 'error';
          qCamEl.textContent  = '—';
          qAnEl.textContent   = '—';
        }

      }

      function watchQuality(pc, label, outEl) {
        if (!pc || !outEl) return;
        const rx = pc.getTransceivers().find(t => t.receiver?.track?.kind === 'video')?.receiver;
        if (!rx) return;

        setInterval(async () => {
          try {
            const stats = await rx.getStats();
            let rtp;
            stats.forEach(r => { if (r.type === 'inbound-rtp' && r.kind === 'video') rtp = r; });
            if (!rtp) return;

            // fps si dispo (optionnel, tu as déjà un compteur dédié)
            const fps = rtp.framesPerSecond ?? null;

            // jitter buffer moyen (ms)
            const jbMs = (rtp.jitterBufferDelay != null && rtp.jitterBufferEmittedCount > 0)
              ? (rtp.jitterBufferDelay / rtp.jitterBufferEmittedCount) * 1000
              : null;

            // temps moyen de décodage (ms)
            const decMs = (rtp.totalDecodeTime != null && rtp.framesDecoded > 0)
              ? (rtp.totalDecodeTime / rtp.framesDecoded) * 1000
              : null;

            // Affichage compact
            const parts = [];
            if (jbMs != null)  parts.push(`jitter ~${jbMs.toFixed(0)} ms`);
            if (decMs != null) parts.push(`decode ~${decMs.toFixed(0)} ms`);
            outEl.textContent = parts.length ? parts.join(' • ') : '—';
          } catch {}
        }, 1000);
      }

      // ==== Sampler ROI (faible overhead) =========================================
      function makeSampler(videoEl, opts = {}) {
        const ROI = Object.assign({ x:0.02, y:0.02, w:0.06, h:0.06 }, opts.roi || {});
        const keepMs = opts.historyMs ?? 3500;

        const cnv = document.createElement('canvas');
        const ctx = cnv.getContext('2d', { willReadFrequently: true });
        const buf = []; // { t, v } avec t = performance.now(), v = luma moyenne ROI

        function sample() {
          if (!videoEl || videoEl.readyState < 2) return;
          const vw = videoEl.videoWidth|0, vh = videoEl.videoHeight|0;
          if (!vw || !vh) return;

          const rx = (ROI.x*vw)|0, ry = (ROI.y*vh)|0;
          const rw = Math.max(4,(ROI.w*vw)|0), rh = Math.max(4,(ROI.h*vh)|0);

          cnv.width = rw; cnv.height = rh;
          ctx.drawImage(videoEl, rx, ry, rw, rh, 0, 0, rw, rh);
          const id = ctx.getImageData(0,0,rw,rh).data;

          // luma moyenne
          let s = 0, n = rw*rh;
          for (let i=0;i<n;i++){
            const r=id[4*i], g=id[4*i+1], b=id[4*i+2];
            s += (0.2126*r + 0.7152*g + 0.0722*b);
          }
          const now = performance.now();
          buf.push({ t: now, v: s/n });
          // fenêtre glissante
          while (buf.length && now - buf[0].t > keepMs) buf.shift();
        }

        
          function tickRVFC(_now, _meta){ sample(); try{ videoEl.requestVideoFrameCallback(tickRVFC);}catch{} }
          function tickRAF(){ sample(); requestAnimationFrame(tickRAF); }

          if ('requestVideoFrameCallback' in HTMLVideoElement.prototype) {
            try { videoEl.requestVideoFrameCallback(tickRVFC); } catch { requestAnimationFrame(tickRAF); }
          } else {
            requestAnimationFrame(tickRAF);
          }
          return () => buf.slice(); // getter immuable
        }

        // ==== Prétraitement + Recalage temps (10 ms) ================================
        function resampleZ(series, stepMs = 10, spanMs = 2500) {
          if (!series || series.length < 5) return { t:[], v:[] };
          const end = series[series.length - 1].t;
          const start = Math.max(series[0].t, end - spanMs);
          const n = Math.max(1, Math.floor((end - start)/stepMs) + 1);

          const outT = new Array(n);
          const outV = new Array(n);
          let i = series.findIndex(p => p.t >= start);
          if (i < 0) i = 0;

          for (let k=0;k<n;k++){
            const t = start + k*stepMs;
            outT[k] = t;
            while (i+1 < series.length && series[i+1].t < t) i++;
            const p0 = series[i];
            const p1 = series[Math.min(i+1, series.length-1)];
            const v = (p1.t === p0.t) ? p0.v : p0.v + (p1.v - p0.v) * ((t - p0.t) / (p1.t - p0.t));
            outV[k] = v;
          }

          // High-pass simple (différence première), puis z-score + soft-clip
          for (let k=outV.length-1;k>0;k--) outV[k] = outV[k] - outV[k-1];
          outV[0] = 0;

          const mean = outV.reduce((a,b)=>a+b,0)/outV.length;
          const sd = Math.sqrt(outV.reduce((a,b)=>a+(b-mean)*(b-mean),0)/outV.length) || 1;
          for (let k=0;k<outV.length;k++){
            let z = (outV[k]-mean)/sd;
            if (z > 3) z = 3; else if (z < -3) z = -3; // soft-clip
            outV[k] = z;
          }
          return { t: outT, v: outV, stepMs };
        }

        // ==== Corrélation normalisée robuste dans [-1000, +1000] ms =================
        function xcorrLagMs(Araw, Braw, opts = {}) {
          const { lagMin=-1000, lagMax=1000, step=5, prevLag=null } = opts;
          const A = resampleZ(Araw, 10, 2500);
          const B = resampleZ(Braw, 10, 2500);
          const La = A.v.length, Lb = B.v.length;
          if (La < 30 || Lb < 30) return null;

          const stepMs = 10;
          let best = { lag:0, score:-Infinity, count:0 };
          let second = { score:-Infinity };

          for (let L=lagMin; L<=lagMax; L+=step) {
            const m = Math.round(L/stepMs); // décalage en indices
            // portion qui se chevauche
            const i0 = Math.max(0, -m);
            const i1 = Math.min(La, Lb - m);
            const cnt = i1 - i0;
            if (cnt < 30) continue;

            // corr normalisée
            let s=0, sa=0, sb=0;
            for (let i=i0;i<i1;i++){
              const a = A.v[i], b = B.v[i+m];
              s  += a*b;
              sa += a*a;
              sb += b*b;
            }
            let score = s / Math.sqrt(sa*sb || 1);

            // petit biais de continuité (récompense proximité du prevLag)
            if (prevLag != null) {
              const d = Math.abs(L - prevLag);
              score += Math.exp(-d/200) * 0.02; // 0.02 max, doux mais utile
            }

            if (score > best.score) { second = best; best = { lag:L, score, count:cnt }; }
            else if (score > second.score) { second = { lag:L, score, count:cnt }; }
          }

          if (best.score === -Infinity) return null;

          // confiance = marge vs 2ᵈ pic + quantité d’échantillons
          const margin = best.score - Math.max(-1, second.score);
          const qty    = Math.min(1, best.count/120); // saturé à ~1.2 s
          const confidence = Math.max(0, Math.min(1, 0.6*margin + 0.4*qty));

          return { lag: best.lag, score: best.score, confidence, count: best.count };
        }

        // ==== Tracker (continuité + lissage) ========================================
        function makeLagTracker() {
          let prev = null;     // dernière estim brute
          let ema  = null;     // lissage
          return {
            estimate(getA, getB) {
              const A = getA(), B = getB();
              const res = xcorrLagMs(A, B, { lagMin:-1000, lagMax:1000, step:5, prevLag: prev });
              if (!res) return null;
              prev = res.lag;
              const alpha = res.confidence >= 0.4 ? 0.45 : 0.25;  // plus de confiance → plus de réactivité
              ema = (ema == null) ? res.lag : (1-alpha)*ema + alpha*res.lag;
              return { lag: ema, confidence: res.confidence, score: res.score };
            },
            reset(){ prev = null; ema = null; }
          };
        }

      function stop() {
        // 1) Timer & tracker
        if (lagTimer) { clearInterval(lagTimer); lagTimer = null; }
        lagTracker.reset();

        // 2) Samplers (on relancera proprement au prochain start)
        getCamFn = null;
        getAnnotFn = null;

        // 3) Ferme les PeerConnections
        for (const pc of [pcCam, pcAnnot]) {
          try { pc && pc.close(); } catch {}
        }
        pcCam = null;
        pcAnnot = null;

        // 4) Détache les médias
        if (videoCam)   videoCam.srcObject   = null;
        if (videoAnnot) videoAnnot.srcObject = null;

        // 5) Remet l’UI à zéro
        fpsCamEl.textContent = '—';
        fpsAnEl.textContent  = '—';
        stCamEl.textContent  = 'stopped';
        stAnEl.textContent   = 'stopped';
        qCamEl.textContent   = '—';
        qAnEl.textContent    = '—';
      }

      startBtn?.addEventListener('click', start);
      stopBtn?.addEventListener('click',  stop);

      // Auto-start
      const waitPlaying = (v) => new Promise((resolve) => {
        if (v && v.readyState >= 2 && !v.paused) return resolve();
        const onPlay = () => { v.removeEventListener('playing', onPlay); resolve(); };
        v.addEventListener('playing', onPlay, { once: true });
      });
      start();
    </script>

  </body>
</html>
