---
import SiteLayout from '../layouts/SiteLayout.astro';
import DebugLayout from '../layouts/DebugLayout.astro';
import VideoCard from '../components/VideoCard.astro';
// @ts-ignore  ← ajoute cette ligne

const TITLE = 'Vision Hub - Démos - Debug';
const NOTE  = 'Aperçu faible latence (WebRTC) – cam & annot + compteur FPS.';
---
<DebugLayout title={TITLE} note={NOTE}>
  <div class="grid">
    <VideoCard title="Preview (WebRTC – cam)"
      videoId="webrtc" fpsId="fpsCam" qualityId="qCam" stateId="rtcCam" />
    <VideoCard title="Annotation (WebRTC – annot)"
      videoId="annotRtc" fpsId="fpsAnnot" qualityId="qAnnot" stateId="rtcAnnot" />
  </div>

  <div class="card" style="margin-top:16px">
    <h3 style="margin:6px 0 12px">Endpoints</h3>
    <div class="kvs">
      <b>WHEP cam</b><span id="epCam">—</span>
      <b>WHEP annot</b><span id="epAnnot">—</span>
      <b>Tips</b><span>Ouvre 8889/TCP et 8189/UDP (ICE) sur MediaMTX.</span>
    </div>
  </div>

  <div class="card">
    <h3 style="margin:6px 0 12px">Cam (Overlay client – WebRTC + canvas)</h3>
    <div class="stack">
      <video id="camOverlay" autoplay playsinline muted></video>
      <canvas id="ovl"></canvas>
    </div>
    <div class="kvs" style="margin-top:8px">
      <b>Qualité</b><span id="qOverlay">—</span>
    </div>
  </div>

  <!-- Scripts — ordre important -->
  <script type="module" src="/scripts/debug-entry.js"></script>
</DebugLayout>
