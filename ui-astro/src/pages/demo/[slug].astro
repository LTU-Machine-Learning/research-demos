---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ConsentModal from '../../components/ConsentModal.astro';
export const prerender = true;

import demos from "../../lib/demos";

export async function getStaticPaths() {
  return [
    { params: { slug: 'yolo' } },
    { params: { slug: 'pose' } },
    { params: { slug: 'price' } },
  ];
}

const { slug } = Astro.params;
const cfg = demos(slug);
const title = cfg.title;
const description = cfg.subtitle ?? '';
---

<SiteLayout {title} {description}>
  <ConsentModal demoId={cfg.demoId} ttlSeconds={600} />

  <style>
    body { margin: 0; background: #0b0d12; color: #e8eefc; font-family: system-ui; }
    .wrap { max-width: 900px; margin: 48px auto; padding: 0 16px; }

    /* --- shared card style --- */
    .card {
      background: rgba(20,24,36,0.95);
      border-radius: 24px;
      box-shadow: 0 6px 24px #0005;
      padding: 24px;
      margin-top: 24px;
    }

    /* --- video demo layout --- */
    .stack { position: relative; display: inline-block; width: 100%; }
    video, canvas { width: 100%; border-radius: 12px; display:block; }
    #yolo-loading {
      position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
      background:#0b0d12aa; border-radius:12px;
    }

    /* --- form demo layout --- */
    form { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 12px 18px; }
    label { display:flex; flex-direction:column; gap:4px; font-size:0.95rem; }
    input, select {
      background:#101827; color:#e8eefc; border:1px solid #2a3652;
      padding:8px 10px; border-radius:8px; outline:none;
    }
    button {
      background:#27d07d; color:#081120; border:none; border-radius:10px;
      font-weight:600; padding:10px 18px; cursor:pointer;
      transition:background .18s;
    }
    button:hover { background:#32e88f; }

    .result {
      margin-top: 24px;
      background: #141a28;
      border-radius: 12px;
      padding: 16px 20px;
      color: #b0bedc;
    }
    .result .big { font-size: 1.4rem; margin-bottom: 6px; }

    /* --- validation + error UI --- */
    .req { color:#ff7d7d; }
    .error {
      background:#2a1020; border:1px solid #b9466b; color:#ffd9e4;
      padding:10px 12px; border-radius:10px; margin: 0 0 12px 0; font-size:.95rem;
    }
    .invalid { border-color:#ff7d7d !important; box-shadow:0 0 0 2px #ff7d7d33; }
  </style>

  <div class="wrap">
    <h1>{cfg.title}</h1>
    <p>{cfg.subtitle}</p>

    {cfg.kind === 'video' ? (
      /* ========================= VIDEO TEMPLATE ========================= */
      <div class="card">
        <div class="title">
          <h3>Live Stream</h3>
          <div class="row" style="display:flex;gap:12px;align-items:center;">
            <span>Status: <b id="state">—</b></span>
            <span>FPS: <b id="fps">—</b></span>
          </div>
        </div>

        <div
          id="yolo-root"
          class="stack"
          data-transport={cfg.transport}
          data-cam={cfg.cam ?? ""}
          data-mjpeg={cfg.mjpeg ?? ""}
          data-ws={cfg.ws ?? ""}
          data-ws-kind={cfg.wsKind ?? "boxes"}
          data-orch={cfg.orch ?? ":8090"}
          data-token={cfg.token ?? "dev-token"}
          data-demoid={cfg.demoId}
        >
          <video id="yolo-video" autoplay playsinline muted></video>
          <canvas id="yolo-canvas"></canvas>
          <div id="yolo-loading" aria-hidden="true">
            <span>Loading live stream…</span>
          </div>
        </div>
      </div>
    ) : (
      {/* ========================= FORM TEMPLATE ========================= */}
      <div class="card">
        <h3>House Price Estimation</h3>

        <!-- custom error box -->
        <div id="p-error" class="error" hidden role="alert"></div>

        <form
          id="price-form"
          novalidate
          data-api={cfg.api ?? import.meta.env.PUBLIC_PRICE_API ?? 'http://localhost:8080/predict'}
        >
          <label>
            Living area (sqm) <span class="req">*</span>
            <input type="number" name="living_area" min="10" step="1" value="60" />
          </label>
          <label>
            Rooms <span class="req">*</span>
            <input type="number" name="rooms" min="1" step="0.5" value="3" />
          </label>
          <label>
            Plot area (sqm)
            <input type="number" name="plot_area" min="0" step="1" value="0" />
          </label>
          <label>
            Housing type
            <select name="housing_type">
              <option value="">(auto)</option>
              <option>APARTMENT</option>
              <option>HOUSE</option>
              <option>ROW_HOUSE</option>
              <option>OTHER</option>
            </select>
          </label>
          <label>
            Municipality
            <input type="text" name="municipality" placeholder="Göteborgs kommun" />
          </label>
          <label>
            Address / area
            <input type="text" name="address" placeholder="Hisings Backa" />
          </label>
          <label>
            Latitude
            <input type="number" name="lat" step="0.0001" placeholder="57.7470" />
          </label>
          <label>
            Longitude
            <input type="number" name="lon" step="0.0001" placeholder="11.9700" />
          </label>

          <div style="grid-column:1 / -1; display:flex; gap:10px; align-items:center;">
            <button id="btn-estimate" type="submit">Estimate</button>
            <span id="p-loading" style="display:none;">estimating…</span>
          </div>
        </form>

        <div id="price-result" class="result" hidden>
          <div class="big">Predicted price: <b id="p-price">—</b></div>
          <div>Prediction interval: <span id="p-low">—</span> – <span id="p-high">—</span></div>
        </div>
      </div>

      <script is:inline type="module">
        const form    = document.getElementById('price-form');
        const box     = document.getElementById('price-result');
        const pEl     = document.getElementById('p-price');
        const loEl    = document.getElementById('p-low');
        const hiEl    = document.getElementById('p-high');
        const errBox  = document.getElementById('p-error');
        const loading = document.getElementById('p-loading');

        // Read API endpoint from the form's data attribute (set server-side)
        const api = form.dataset.api || 'http://localhost:8080/predict';

        const STORAGE_KEY = 'vh_price_form';
        const fmt = n => new Intl.NumberFormat('sv-SE', { style:'currency', currency:'SEK', maximumFractionDigits:0 }).format(n);

        function showError(msg) {
          errBox.textContent = msg;
          errBox.hidden = false;
        }
        function clearError() {
          errBox.hidden = true;
          errBox.textContent = '';
        }
        function markInvalid(names) {
          for (const el of form.querySelectorAll('.invalid')) el.classList.remove('invalid');
          names.forEach(n => {
            const el = form.elements.namedItem(n);
            if (el) el.classList.add('invalid');
          });
        }

        // Restore persisted values
        try {
          const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
          if (saved && typeof saved === 'object') {
            for (const [k,v] of Object.entries(saved)) {
              const el = form.elements.namedItem(k);
              if (el && v !== undefined && v !== null && v !== '') el.value = v;
            }
          }
        } catch {}

        // Persist on input
        form.addEventListener('input', () => {
          const fd = new FormData(form);
          const obj = {};
          for (const [k,v] of fd.entries()) obj[k] = v;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(obj));
        });

        function collectBody() {
          const fd = new FormData(form);
          const body = {};
          for (const [k, v] of fd.entries()) {
            if (v === '' || v == null) continue;
            body[k] = ['living_area','rooms','plot_area','lat','lon','month','year'].includes(k) ? Number(v) : v;
          }
          return body;
        }

        function validate(body) {
          const missing = [];
          if (body.living_area == null || isNaN(body.living_area)) missing.push('living_area');
          if (body.rooms == null || isNaN(body.rooms))             missing.push('rooms');
          return missing;
        }

        form.addEventListener('submit', async (e) => {
          e.preventDefault(); // stop navigation
          clearError();
          box.hidden = true;
          loading.style.display = 'inline';

          const body = collectBody();
          const missing = validate(body);
          if (missing.length) {
            loading.style.display = 'none';
            markInvalid(missing);
            showError(`Please fill the required field(s): ${missing.join(', ')}.`);
            return;
          }
          markInvalid([]);

          try {
            const r = await fetch(api, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!r.ok) {
              let detail = '';
              try { detail = (await r.json()).detail; } catch { detail = await r.text(); }
              showError(detail || `Request failed (HTTP ${r.status}).`);
              return;
            }
            const data = await r.json();
            pEl.textContent  = fmt(data.price_sek);
            loEl.textContent = fmt(data.pi_low);
            hiEl.textContent = fmt(data.pi_high);
            box.hidden = false;
          } catch (err) {
            showError(err?.message || 'Network error.');
          } finally {
            loading.style.display = 'none';
          }
        });
      </script>

  )}
</SiteLayout>
