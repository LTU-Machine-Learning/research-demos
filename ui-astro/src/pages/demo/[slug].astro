---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ConsentModal from '../../components/ConsentModal.astro'; // ⬅️ add
export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { slug: 'yolo' } },
    { params: { slug: 'pose' } },
    // add more demos here…
  ];
}

import demos from "../../lib/demos";

const { slug } = Astro.params;
const cfg = demos(slug);
const title = cfg.title;
const description = cfg.subtitle ?? '';
---

<SiteLayout {title} {description}>
  <!-- Consent modal mounted here; viewer.js will call window["askConsent_<demoId>"] when needed -->
  <ConsentModal demoId={cfg.demoId} ttlSeconds={600} />

  <!-- Tout ce que tu mettras ici va dans <main class="page"> de ton layout -->

  <!-- (Optionnel) Injecte head spécifique via le slot "head" -->
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/debug.css" />
  </Fragment>

  <div class="wrap">
    <h1>{cfg.title}</h1>
    <p class="sub">{cfg.subtitle}</p>

    <div class="card">
      <div class="title">
        <h3>Live</h3>
        <div class="row">
          <span class="stat">État: <b id="state">—</b></span>
          <span class="stat">FPS: <b id="fps">—</b></span>
          <div class="actions">
            <button id="btn-start"  type="button">Start</button>
            <button id="btn-stop"   type="button">Stop</button>
            <button id="btn-reconn" type="button">Reconnect WS</button>
            <button id="btn-restart" type="button">Restart</button>
            <button id="btn-reset-overlay" type="button">Reset overlay</button>
          </div>
        </div>
      </div>

      <div
        id="yolo-root"
        class="stack"
        data-transport={cfg.transport}
        data-cam={cfg.cam ?? ""}
        data-mjpeg={cfg.mjpeg ?? ""}
        data-ws={cfg.ws ?? ""}
        data-ws-kind={cfg.wsKind ?? "boxes"}
        data-orch={cfg.orch ?? ":8090"}
        data-token={cfg.token ?? "dev-token"}
        data-demoid={cfg.demoId}
      >
        <video id="yolo-video" autoplay playsinline muted></video>
        <canvas id="yolo-canvas"></canvas>
        <div id="yolo-loading" aria-hidden="true">
          <div class="spinner"></div><span>Loading live stream…</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts de ta démo ; la balise <script> fonctionne dans le slot de contenu -->
  <!-- classmap for labels -->
  <script is:inline src="/scripts/overlay-classmap.js"></script>
  <!-- unified viewer (old yolo logic + absolute URLs + MJPEG fallback) -->
  <script is:inline type="module" src="/scripts/viewer.js"></script>
</SiteLayout>
