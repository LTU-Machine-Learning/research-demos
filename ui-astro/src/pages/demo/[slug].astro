---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ConsentModal from '../../components/ConsentModal.astro';

export const prerender = true;

import demos from "../../lib/demos";

export async function getStaticPaths() {
  return [
    { params: { slug: 'yolo' } },
    { params: { slug: 'pose' } },
    { params: { slug: 'price' } },
    { params: { slug: 'chang' } },
    { params: { slug: 'chang_ctw-11n-swin' } },
    { params: { slug: 'chang_test' } },
    { params: { slug: 'chang_3' } },
    { params: { slug: 'chang_4' } },
  ];
}

const { slug } = Astro.params;
const cfg = demos(slug);
const title = cfg.title;
const description = cfg.subtitle ?? "";

// UX-first "About" blurbs (short, readable)
const aboutBySlug: Record<string, { blurb: string; future?: string }> = {
  yolo: {
    blurb: "This live demo highlights detected objects directly on the video feed as you move in front of the camera.",
  },
  pose: {
    blurb: "This live demo tracks people and draws a simple skeleton on top of the video in real time.",
  },
  chang: {
    blurb: "This live demo highlights a detected line of Arabic text on the stream.",
    future: "Future work: extract the selected text after line detection (OCR).",
  },
  "chang_ctw-11n-swin": {
    blurb: "This live demo highlights Characters in the image.",
    future: "Future work: extract the selected text after character detection (OCR).",
  },
  "chang_3": {
    blurb: "This live demo number 3.",
    future: "Future work: extract the selected text after line detection (OCR).",
  },
  "chang_4": {
    blurb: "This live demo number 4.",
    future: "Future work: extract the selected text after line detection (OCR).",
  },
  "chang_test": {
    blurb: "This live demo highlights SOMETHING (TODO CHANGE IN SLUG).",
    future: "Future work: extract the selected text after line detection (OCR).",
  },
  price: {
    blurb: "Fill the form to estimate a housing price and view a predicted range.",
  },
};

const about = aboutBySlug[slug];
---

<SiteLayout {title} {description}>
  <ConsentModal demoId={cfg.demoId} ttlSeconds={600} />

  <style>
    body {
      margin: 0;
      background: radial-gradient(ellipse at top, #0b0d12 0%, #06070d 100%);
      color: #e8eefc;
      font-family: system-ui, sans-serif;
    }

    /* keep your wider page override */
    :global(main.page) {
      max-width: 1400px;
    }

    .wrap {
      max-width: 1280px;
      margin: 40px auto;
      padding: 0 16px;
    }

    h1 { font-size: 1.9rem; font-weight: 600; letter-spacing: .3px; }

    .card{
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      border: 1px solid #1e2436;
      border-radius: 20px;
      box-shadow: 0 10px 24px #0005;
      padding: 32px;
      margin-top: 32px;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px #0006; }

    /* video stack (yolo/pose/chang) */
    .stack {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      min-height: clamp(380px, 60vh, 780px);
      background: #000;
      border-radius: 14px;
      overflow: hidden;
    }
    .stack video, .stack canvas, #yolo-loading {
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      display:block;
      border-radius:14px;
    }

    /* Loading overlay UX */
    #yolo-loading {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      font-weight: 600;
      color: #e8eefc;
      background: radial-gradient(ellipse at center, rgba(20,26,39,.85), rgba(0,0,0,.65));
    }
    #yolo-root.ready #yolo-loading { display: none; }
    #yolo-root.loading #yolo-loading { display: flex; }
    #yolo-root.stopped #yolo-loading { display: flex; }

    /* About block (short, readable) */
    .info{
      margin-top: 18px;
      padding: 16px 18px;
      border-radius: 16px;
      border: 1px solid #1e2436;
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      box-shadow: 0 10px 24px #0004;
    }
    .info h2{ margin:0 0 8px; font-size: 1.05rem; }
    .info-blurb{
      margin:0;
      color:#cfe0ff;
      opacity:.92;
      line-height: 1.45;
    }
    .info-future{
      margin:10px 0 0;
      color:#b0bedc;
      opacity:.85;
      font-size: .95rem;
    }

    /* COCO browser (YOLO) */
    .coco-card{
      margin-top: 14px;
      padding: 14px 14px 16px;
      border-radius: 16px;
      border: 1px solid #1e2436;
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      box-shadow: 0 10px 24px #0004;

      /* keep card height behavior stable */
      display: flex;
      flex-direction: column;
    }
    .coco-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap: 12px;
      margin-bottom: 10px;
      flex: 0 0 auto;
    }
    .coco-title{ font-weight: 700; color:#e8eefc; }
    .coco-sub{ font-size: .92rem; color:#b0bedc; opacity:.9; margin-top:2px; }
    .coco-search{
      flex: 0 1 360px;
      background:#0f1625;
      color:#e8eefc;
      border:1px solid #2a3652;
      border-radius: 12px;
      padding: 9px 12px;
      outline:none;
    }
    .coco-search:focus{ border-color:#2f82ff; box-shadow:0 0 0 3px #2f82ff22; }

    .coco-tabs{
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      margin: 10px 0 12px;
      flex: 0 0 auto;
    }
    .coco-tab{
      border: 1px solid #2a3652;
      background:#0f1625;
      color:#cfe7ff;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: .85rem;
      cursor:pointer;
      user-select:none;
    }
    .coco-tab.active{
      border-color:#27d07d66;
      background:#0f1e1a;
      color:#27d07d;
      font-weight: 700;
    }

    /* ✅ FIX: make chips wrap into multiple lines and keep the box fixed */
    .coco-grid{
      flex: 0 0 auto;
      display: grid;

      /* multi-line responsive wrapping */
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 8px;

      /* fixed height so the overall card does not resize per category */
      height: clamp(140px, 22vh, 220px);
      overflow: auto;
      padding: 2px;

      border-radius: 12px;
      border: 1px solid #1e2436;
      background: rgba(0,0,0,.12);

      scroll-behavior: smooth;
    }

    .coco-chip{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;

      padding: 7px 10px;
      border-radius: 999px;

      border:1px solid #2a3652;
      background:#0f1625;
      color:#e8eefc;
      font-size: .86rem;

      /* prevent long labels from breaking layout */
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .coco-chip.dim{ opacity:.55; }

    /* optional: nicer scrollbar on webkit */
    .coco-grid::-webkit-scrollbar{ height: 10px; width: 10px; }
    .coco-grid::-webkit-scrollbar-thumb{ background: #1f2a44; border-radius: 999px; }
    .coco-grid::-webkit-scrollbar-track{ background: transparent; }

    /* Pose explain box */
    .pose-card{
      margin-top: 14px;
      padding: 14px 14px 16px;
      border-radius: 16px;
      border: 1px solid #1e2436;
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      box-shadow: 0 10px 24px #0004;
    }
    .pose-title{ font-weight: 700; color:#e8eefc; margin-bottom: 6px; }
    .pose-text{ color:#cfe0ff; opacity:.92; line-height: 1.45; }
    .pose-hint{ margin-top: 10px; color:#b0bedc; opacity:.85; font-size:.92rem; }

    /* form grid (price) */
    form{
      display:grid;
      grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
      gap:16px 22px;
      margin-top: 8px;
    }
    label{ display:flex; flex-direction:column; gap:6px; font-size:.95rem; font-weight:500; position:relative; }
    label.required .lab::after{ content:" *"; color:#ff7d7d; }

    input, select{
      background:#0f1625; color:#e8eefc; border:1px solid #2a3652;
      padding:10px 12px; border-radius:10px; outline:none; transition:border .15s, box-shadow .15s;
    }
    input:focus, select:focus{ border-color:#2f82ff; box-shadow:0 0 0 3px #2f82ff33; }

    .legend{ grid-column:1 / -1; margin-top:10px; padding-top:12px; border-top:1px dashed #2a3652; font-size:.9rem; opacity:.75; }

    button{
      grid-column:1 / -1;
      background: linear-gradient(120deg, #27d07d 0%, #1fb86b 100%);
      color:#081120; border:none; border-radius:12px; font-weight:600;
      padding:12px 20px; cursor:pointer; transition:transform .15s ease, filter .15s ease;
    }
    button:hover{ filter:brightness(1.08); transform:translateY(-1px); }

    .error{ background:#2a1020; border:1px solid #b9466b; color:#ffd9e4; padding:10px 14px; border-radius:10px; margin-bottom:12px; }
    .invalid{ border-color:#ff7d7d !important; box-shadow:0 0 0 2px #ff7d7d33; }

    .result{
      margin-top: 28px;
      background: linear-gradient(150deg, #121725 0%, #10131b 100%);
      border:1px solid #23283b; border-radius:16px; padding:20px 24px; color:#b0bedc;
      animation: fadeIn .3s ease;
    }
    .result .big{ font-size:1.5rem; font-weight:600; color:#27d07d; margin-bottom:6px; }
    @keyframes fadeIn{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }

    .helper{ font-size:.8rem; opacity:.7; margin-top:-4px; }

    /* Debug chip + panel (video demos) */
    .debug-wrap {
      position: relative;
      display: inline-block;
    }

    #dbg-toggle {
      background:#1f2937;
      border:1px solid #374151;
      color:#e5e7eb;
      border-radius:999px;
      font-size:.8rem;
      padding:5px 10px;
      cursor:pointer;
    }

    /* Popup panel */
    #dbg-panel {
      position:absolute;
      right:0;
      top:120%;
      background:#020617;
      border:1px solid #1f2937;
      border-radius:12px;
      padding:8px 10px;
      box-shadow:0 10px 22px #000a;
      z-index:50;
      min-width: 160px;
    }

    /* Header row inside panel */
    .debug-chip-header {
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:4px;
    }

    .debug-chip-header span {
      font-size:.72rem;
      opacity:.7;
    }

    /* Tiny circular close button */
    .debug-chip-close {
      width:22px;
      height:22px;
      border-radius:999px;
      border:1px solid #1f2a44;
      background:#020617;
      color:#e5e7eb;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:.8rem;
      cursor:pointer;
      padding:0;
    }

    /* Column of buttons */
    .debug-chip-row {
      display:flex;
      flex-direction:column;
      gap:4px;
    }

    /* Slim pill buttons */
    .debug-chip-btn {
      display:flex;
      align-items:center;
      justify-content:flex-start;
      width:100%;
      padding:4px 9px;
      border-radius:999px;
      border:1px solid #111827;
      background:#020617;
      color:#e5e7eb;
      font-size:.76rem;
      cursor:pointer;
      white-space:nowrap;
    }

    .debug-chip-btn[disabled] {
      opacity:.45;
      cursor:default;
    }

    @media (max-width: 640px) {
      .wrap { margin: 24px auto; }
      .stack { min-height: 280px; }
      .coco-head{ flex-direction: column; align-items: stretch; }
      .coco-search{ flex: 1 1 auto; width: 100%; }
    }
  </style>


  <div class="wrap">
    <h1>{cfg.title}</h1>
    <p>{cfg.subtitle}</p>

    {about && (
      <div class="info">
        <h2>About this demo</h2>
        <p class="info-blurb">{about.blurb}</p>
        {about.future && (
          <p class="info-future"><b>Future:</b> {about.future}</p>
        )}
      </div>
    )}

    {cfg.kind === 'video' ? (
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <h3 style="margin:0;">Live Stream</h3>
          <div style="display:flex;gap:12px;align-items:center;">
            <span>FPS: <b id="fps">—</b></span>

            <!-- Debug toggle + panel -->
            <div class="debug-wrap">
              <button type="button" id="dbg-toggle">Debug</button>
              <div id="dbg-panel" style="display:none;">
                <div class="debug-chip-header">
                  <span>Debug controls</span>
                  <button
                    type="button"
                    id="dbg-close"
                    class="debug-chip-close"
                    aria-label="Close debug panel"
                  >
                    ×
                  </button>
                </div>

                <div class="debug-chip-row">
                  <button type="button" id="btn-start"         class="debug-chip-btn">Start</button>
                  <button type="button" id="btn-stop"          class="debug-chip-btn">Stop</button>
                  <button type="button" id="btn-reconn"        class="debug-chip-btn">Reconnect WS</button>
                  <button type="button" id="btn-restart"       class="debug-chip-btn">Restart demo</button>
                  <button type="button" id="btn-reset-overlay" class="debug-chip-btn">Reset overlay</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          id="yolo-root"
          class="stack"
          data-transport={cfg.transport}
          data-cam={cfg.cam ?? ""}
          data-mjpeg={cfg.mjpeg ?? ""}
          data-ws={cfg.ws ?? ""}
          data-ws-kind={cfg.wsKind ?? "boxes"}
          data-orch={cfg.orch ?? ":8090"}
          data-token={cfg.token ?? "dev-token"}
          data-demoid={cfg.demoId}
        >
          <video id="yolo-video" autoplay playsinline muted></video>
          <canvas id="yolo-canvas"></canvas>
          <div id="yolo-loading" aria-hidden="true">
            <span>Loading live stream…</span>
          </div>
        </div>

        {slug === "yolo" && (
          <div class="coco-card" id="coco-card">
            <div class="coco-head">
              <div>
                <div class="coco-title">Detectable objects</div>
                <div class="coco-sub">Browse the 80 COCO classes used by the demo.</div>
              </div>
              <input
                id="coco-q"
                class="coco-search"
                type="search"
                placeholder="Search (e.g. person, chair, phone…)"
                autocomplete="off"
              />
            </div>

            <div class="coco-tabs" id="coco-tabs"></div>
            <div class="coco-grid" id="coco-grid"></div>
          </div>
        )}

        {slug === "pose" && (
          <div class="pose-card">
            <div class="pose-title">What the skeleton means</div>
            <div class="pose-text">
              The dots are <b>body keypoints</b> (like shoulders, elbows, wrists, hips, knees, ankles).
              Lines connect these points to form a simple skeleton so you can see posture and movement.
            </div>
            <div class="pose-hint">
              Tip: move closer to the camera for more stable keypoints.
            </div>
          </div>
        )}
      </div>
    ) : (
      <div class="card">
        <div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
          <div class="debug-wrap">
            <button
              type="button"
              id="price-debug-toggle"
              style="background:#1f2937;border:1px solid #374151;color:#e5e7eb;
                    border-radius:999px;font-size:.8rem;padding:4px 10px;cursor:pointer;"
            >
              Debug
            </button>
          </div>
        </div>
        <div
          id="price-debug-panel"
          style="display:none;margin-bottom:8px;padding:8px 10px;border-radius:10px;
                border:1px dashed #374151;background:#020617;font-size:.8rem;"
        >
          <strong style="display:block;margin-bottom:6px;">Debug actions</strong>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <button type="button" id="price-restart" style="font-size:.75rem;padding:4px 8px;">
              Ensure demo running
            </button>
            <button type="button" id="price-health" style="font-size:.75rem;padding:4px 8px;">
              Check /healthz
            </button>
          </div>
          <div id="price-debug-status" style="margin-top:6px;opacity:.7;"></div>
        </div>
        <h3 style="margin-top:0;">House Price Estimation</h3>

        <div id="p-error" class="error" hidden role="alert"></div>

        <form
          id="price-form"
          novalidate
          data-api={cfg.api ?? import.meta.env.PUBLIC_PRICE_API ?? 'http://192.168.10.1:8080/predict'}
          data-orch={cfg.orch ?? ':8090'}
          data-token={cfg.token ?? 'dev-token'}
          data-demoid={cfg.demoId}
        >
          <!-- Required -->
          <label class="required">
            <span class="lab">Living area (sqm)</span>
            <input type="number" name="living_area" min="10" step="1" value="60" />
            <span class="helper">Heated living space (“boarea”).</span>
          </label>
          <label class="required">
            <span class="lab">Rooms</span>
            <input type="number" name="rooms" min="1" step="0.5" value="3" />
            <span class="helper">Whole rooms (e.g. “rok”).</span>
          </label>

          <!-- Optional -->
          <label>
            <span class="lab">Plot area (sqm)</span>
            <input type="number" name="plot_area" min="0" step="1" placeholder="e.g. 300" />
          </label>
          <label>
            <span class="lab">Housing type</span>
            <select name="housing_type">
              <option value="">(auto)</option>
              <option>APARTMENT</option>
              <option>HOUSE</option>
              <option>ROW_HOUSE</option>
              <option>OTHER</option>
            </select>
          </label>
          <label>
            <span class="lab">Municipality</span>
            <input type="text" name="municipality" placeholder="Luleå" />
          </label>
          <label>
            <span class="lab">Address / area</span>
            <input type="text" name="address" placeholder="Bergviken" />
          </label>
          <label>
            <span class="lab">Latitude</span>
            <input type="number" name="lat" step="0.0001" placeholder="65.5833" />
          </label>
          <label>
            <span class="lab">Longitude</span>
            <input type="number" name="lon" step="0.0001" placeholder="22.1500" />
          </label>

          <div class="legend">Optional — time context</div>
          <label>
            <span class="lab">Month (1–12)</span>
            <input type="number" name="month" min="1" max="12" step="1" placeholder="(auto)" />
          </label>
          <label>
            <span class="lab">Year</span>
            <input type="number" name="year" min="2000" max="2100" step="1" placeholder="(auto)" />
          </label>

          <div class="legend">Optional — Booli-enriched</div>
          <label>
            <span class="lab">Construction year</span>
            <input type="number" name="construction_year" min="1800" max="2100" step="1" placeholder="e.g. 1978" />
          </label>
          <label>
            <span class="lab">Floor</span>
            <input type="number" name="floor" step="0.5" placeholder="e.g. 2" />
          </label>
          <label>
            <span class="lab">Monthly rent (SEK)</span>
            <input type="number" name="rent" min="0" step="100" placeholder="e.g. 4500" />
          </label>
          <label>
            <span class="lab">List price (SEK)</span>
            <input type="number" name="list_price" min="0" step="50000" placeholder="e.g. 2 500 000" />
          </label>

          <button id="btn-estimate" type="submit">Estimate Price</button>
          <span id="p-loading" style="display:none;">estimating…</span>
        </form>

        <div id="price-result" class="result" hidden>
          <div class="big">Predicted price: <b id="p-price">—</b></div>
          <div>Prediction interval: <span id="p-low">—</span> – <span id="p-high">—</span></div>
        </div>
      </div>
    )}
  </div>

  {cfg.kind === 'video' && (
    <>
      {/* COCO class map → exposes window.overlayClassMap */}
      <script src="/scripts/overlay-classmap.js" is:inline></script>

      {/* Viewer logic (uses globalThis.overlayClassMap if present) */}
      <script type="module" src="/scripts/viewer.js" is:inline></script>

      <script is:inline>
        (function () {
          const toggle = document.getElementById('dbg-toggle');
          const panel  = document.getElementById('dbg-panel');
          const close  = document.getElementById('dbg-close');

          if (!toggle || !panel) return;

          const hide = () => { panel.style.display = 'none'; };
          const show = () => { panel.style.display = 'block'; };

          toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            if (panel.style.display === 'none' || !panel.style.display) show();
            else hide();
          });

          close?.addEventListener('click', (e) => {
            e.stopPropagation();
            hide();
          });

          document.addEventListener('click', (e) => {
            if (!panel.contains(e.target) && e.target !== toggle) hide();
          });
        })();
      </script>

      {slug === "yolo" && (
        <script is:inline>
          (function () {
            const map = window.overlayClassMap || null;
            if (!map) return;

            const all = Object.keys(map).map(k => map[k]).filter(Boolean);
            const set = new Set(all);

            // UX categories: "Common" first, then other groups.
            const CATS = [
              { id: "common",   label: "Common",   items: ["person","chair","couch","potted plant","tv","laptop","mouse","keyboard","cell phone","book","bottle","cup","remote","backpack","handbag"] },
              { id: "vehicles", label: "Vehicles", items: ["bicycle","car","motorcycle","bus","train","truck","boat","airplane"] },
              { id: "animals",  label: "Animals",  items: ["bird","cat","dog","horse","sheep","cow","elephant","bear","zebra","giraffe"] },
              { id: "kitchen",  label: "Kitchen",  items: ["bowl","fork","knife","spoon","banana","apple","sandwich","orange","broccoli","carrot","hot dog","pizza","donut","cake","wine glass"] },
              { id: "home",     label: "Home",     items: ["bed","dining table","toilet","sink","refrigerator","microwave","oven","toaster"] },
              { id: "sports",   label: "Sports",   items: ["sports ball","frisbee","skis","snowboard","kite","baseball bat","baseball glove","skateboard","surfboard","tennis racket"] },
              { id: "other",    label: "Other",    items: [] },
            ];

            for (const c of CATS) c.items = c.items.filter(x => set.has(x));

            const used = new Set(CATS.flatMap(c => c.items));
            CATS.find(c => c.id === "other").items = all.filter(x => !used.has(x));

            const tabs = document.getElementById("coco-tabs");
            const grid = document.getElementById("coco-grid");
            const q    = document.getElementById("coco-q");
            if (!tabs || !grid || !q) return;

            let active = "common";

            const renderTabs = () => {
              tabs.innerHTML = CATS.map(c => {
                const on = c.id === active ? "active" : "";
                return `<button type="button" class="coco-tab ${on}" data-cat="${c.id}">${c.label}</button>`;
              }).join("");
            };

            const renderGrid = () => {
              const qq = (q.value || "").toLowerCase().trim();

              let items = [];
              if (qq) {
                items = all.filter(x => x.toLowerCase().includes(qq));
              } else {
                const cat = CATS.find(c => c.id === active) || CATS[0];
                items = cat.items.slice();
              }

              grid.innerHTML = items.map(name => `<span class="coco-chip">${name}</span>`).join("");
              if (!items.length) grid.innerHTML = `<span class="coco-chip dim">No match</span>`;
            };

            tabs.addEventListener("click", (e) => {
              const btn = e.target.closest(".coco-tab");
              if (!btn) return;
              active = btn.getAttribute("data-cat") || "common";
              renderTabs();
              renderGrid();
            });

            q.addEventListener("input", () => renderGrid());

            renderTabs();
            renderGrid();
          })();
        </script>
      )}
    </>
  )}

  {cfg.kind !== 'video' && (
    <>
      <script type="module" src="/scripts/prices.js" is:inline></script>
      <script is:inline>
        const t = document.getElementById('price-debug-toggle');
        const p = document.getElementById('price-debug-panel');
        if (t && p) {
          t.addEventListener('click', () => {
            p.style.display = p.style.display === 'none' || !p.style.display ? 'block' : 'none';
          });
        }
      </script>
    </>
  )}
</SiteLayout>
