---
import SiteLayout from '../../layouts/SiteLayout.astro';
import demos from "../../lib/demos";

const cfg = demos('htr');
const title = cfg.title;
const description = cfg.subtitle ?? "";

const about = {
  blurb: "This demo compares two text-line detection models (HiSAM & YOLO) and three text recognition models (English, Norwegian, Swedish) for handwritten text recognition on historical documents.",
  future: "Expand model selection and add confidence scores per line.",
};
---

<SiteLayout {title} {description}>
  <style>
    body {
      margin: 0;
      background: radial-gradient(ellipse at top, #0b0d12 0%, #06070d 100%);
      color: #e8eefc;
      font-family: system-ui, sans-serif;
    }

    :global(main.page) {
      max-width: 1400px;
    }

    .wrap {
      max-width: 1280px;
      margin: 40px auto;
      padding: 0 16px;
    }

    h1 { font-size: 1.9rem; font-weight: 600; letter-spacing: .3px; }

    .card {
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      border: 1px solid #1e2436;
      border-radius: 20px;
      box-shadow: 0 10px 24px #0005;
      padding: 32px;
      margin-top: 32px;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px #0006; }

    /* ---- HTR: wider card + side-by-side layout ---- */
    .card.wide {
      max-width: min(95vw, 1500px);
    }

    .demo-layout {
      display: grid;
      grid-template-columns: 12fr 9fr;
      gap: 0;
      margin-top: 0;
      align-items: start;
    }

    .demo-image-col {
      min-width: 0;
    }

    .demo-text-col {
      min-width: 0;
      padding-left: 2rem;
      max-height: 70vh;
      overflow-y: auto;
      scroll-behavior: smooth;
    }

    .demo-text-col h2 {
      margin-top: 0;
    }

    .demo-text-col::-webkit-scrollbar {
      width: 8px;
    }
    .demo-text-col::-webkit-scrollbar-thumb {
      background: #1f2a44;
      border-radius: 999px;
    }
    .demo-text-col::-webkit-scrollbar-track {
      background: transparent;
    }

    .info {
      margin-top: 18px;
      padding: 16px 18px;
      border-radius: 16px;
      border: 1px solid #1e2436;
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      box-shadow: 0 10px 24px #0004;
    }
    .info h2 { margin: 0 0 8px; font-size: 1.05rem; }
    .info-blurb {
      margin: 0;
      color: #cfe0ff;
      opacity: .92;
      line-height: 1.45;
    }
    .info-future {
      margin: 10px 0 0;
      color: #b0bedc;
      opacity: .85;
      font-size: .95rem;
    }

    input, select {
      background: #0f1625;
      color: #e8eefc;
      border: 1px solid #2a3652;
      padding: 10px 12px;
      border-radius: 10px;
      outline: none;
      transition: border .15s, box-shadow .15s;
    }
    input:focus, select:focus {
      border-color: #2f82ff;
      box-shadow: 0 0 0 3px #2f82ff33;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: .95rem;
      font-weight: 500;
      position: relative;
    }

    /* --- HTR-specific --- */
    #controls {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    #controls .lab {
      color: #e8eefc;
    }

    .checkbox-label {
      flex-direction: row !important;
      align-items: center;
      gap: 8px !important;
      cursor: pointer;
      user-select: none;
    }

    .checkbox-label input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: #27d07d;
      cursor: pointer;
    }

    .checkbox-label span {
      color: #cfe0ff;
      font-size: .95rem;
    }

    .image-container {
      position: relative;
      width: 100%;
      background: #000;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #1e2436;
      box-shadow: 0 10px 24px #0005;
    }

    #page-image {
      display: block;
      width: 100%;
      height: auto;
    }

    #boxes {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    /* --- Transcription (side panel) --- */
    h2 {
      margin-top: 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: #e8eefc;
      position: sticky;
      top: 0;
      background: linear-gradient(165deg, #141a27 0%, #10131c 100%);
      padding-bottom: .5rem;
      z-index: 1;
    }

    #transcription {
      padding-left: 0;
      color: #cfe0ff;
      line-height: 1.55;
      font-size: .95rem;
    }

    #transcription li {
      margin-bottom: .3rem;
      padding: .25rem .5rem;
      border-radius: 6px;
      transition: background .15s;
    }

    #transcription li:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .subtitle {
      color: #b0bedc;
      opacity: .85;
      margin-bottom: 1.5rem;
    }

    @media (max-width: 900px) {
      .demo-layout {
        grid-template-columns: 1fr;
      }

      .demo-text-col {
        padding-left: 0;
        padding-top: 1.5rem;
        max-height: none;
        overflow-y: visible;
      }

      .demo-text-col h2 {
        position: static;
      }
    }

    @media (max-width: 640px) {
      .wrap { margin: 24px auto; }

      #controls {
        flex-direction: column;
        align-items: stretch;
      }

      #controls select {
        width: 100%;
      }

      .card.wide {
        max-width: 100%;
      }
    }
  </style>

  <div class="wrap">
    <h1>{cfg.title}</h1>
    <p>{cfg.subtitle}</p>

    <div class="info">
      <h2>About this demo</h2>
      <p class="info-blurb">{about.blurb}</p>
      <p class="info-future"><b>Future:</b> {about.future}</p>
    </div>

    <div class="card wide">
      <h3 style="margin-top:0;">Model Comparison</h3>

      <form id="controls">
        <label>
          <span class="lab">Document</span>
          <select id="page-select"></select>
        </label>

        <label>
          <span class="lab">Line detector (M1)</span>
          <select id="detector-select"></select>
        </label>

        <label>
          <span class="lab">Text recognizer (M2)</span>
          <select id="recognizer-select"></select>
        </label>

        <label class="checkbox-label">
          <input id="show-boxes" type="checkbox" checked />
          <span>Show bounding boxes</span>
        </label>
      </form>

      <div class="demo-layout">
        <div class="demo-image-col">
          <div class="image-container">
            <img id="page-image" alt="" />
            <svg id="boxes" aria-hidden="true"></svg>
          </div>
        </div>

        <div class="demo-text-col">
          <h2>Recognized text</h2>
          <ol id="transcription"></ol>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import results from '../../data/htr_results.json';

  const pageSelect =
    document.querySelector<HTMLSelectElement>('#page-select')!;
  const detectorSelect =
    document.querySelector<HTMLSelectElement>('#detector-select')!;
  const recognizerSelect =
    document.querySelector<HTMLSelectElement>('#recognizer-select')!;
  const showBoxes =
    document.querySelector<HTMLInputElement>('#show-boxes')!;
  const image =
    document.querySelector<HTMLImageElement>('#page-image')!;
  const overlay =
    document.querySelector<SVGSVGElement>('#boxes')!;
  const transcription =
    document.querySelector<HTMLOListElement>('#transcription')!;

  const imageIds = Object.keys(results);
  let lastImageId = '';

  // Populate the image selector
  imageIds.forEach((id) => {
    pageSelect.add(new Option(results[id].IMG_NAME, id));
  });

  function populateDetectorSelect(imageId: string) {
    const img = results[imageId];
    if (!img) return;
    const m1Models = Object.keys(img.M1);
    detectorSelect.replaceChildren();
    m1Models.forEach((m1) => {
      detectorSelect.add(new Option(m1, m1));
    });
  }

  function populateRecognizerSelect(imageId: string, m1Name: string) {
    const img = results[imageId];
    if (!img) return;
    const m1Data = img.M1[m1Name];
    if (!m1Data) return;
    const bboxKeys = Object.keys(m1Data);
    if (bboxKeys.length === 0) return;
    const firstBbox = m1Data[bboxKeys[0]];
    const m2Models = Object.keys(firstBbox.M2);
    recognizerSelect.replaceChildren();
    m2Models.forEach((m2) => {
      recognizerSelect.add(new Option(m2, m2));
    });
  }

  function drawBoxes(lines: any[]) {
    overlay.setAttribute(
      'viewBox',
      `0 0 ${image.naturalWidth} ${image.naturalHeight}`
    );
    overlay.replaceChildren();

    if (!showBoxes.checked) return;

    for (const line of lines) {
      const [x1, y1, x2, y2] = line.box;
      const rect = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'rect'
      );

      rect.setAttribute('x', String(x1));
      rect.setAttribute('y', String(y1));
      rect.setAttribute('width', String(x2 - x1));
      rect.setAttribute('height', String(y2 - y1));
      rect.setAttribute('fill', 'rgba(39, 208, 125, 0.10)');
      rect.setAttribute('stroke', '#27d07d');
      rect.setAttribute('stroke-width', '2');
      rect.setAttribute('vector-effect', 'non-scaling-stroke');
      rect.setAttribute('rx', '3');
      overlay.append(rect);
    }
  }

  function render() {
    const imageId = pageSelect.value;
    const img = results[imageId];
    if (!img) return;

    const detectorName = detectorSelect.value;
    const recognizerName = recognizerSelect.value;

    // Get lines from the selected M1 model
    const m1Data = img.M1[detectorName];
    const lines: any[] = m1Data ? Object.values(m1Data) : [];

    // Display transcription from the selected M2 model
    transcription.replaceChildren(
      ...lines.map((line: any) => {
        const item = document.createElement('li');
        item.textContent =
          line.M2?.[recognizerName]?.text ?? '';
        return item;
      })
    );

    // Only reload the image when the document actually changes
    if (imageId !== lastImageId) {
      lastImageId = imageId;
      const imagePath =
        `/images/htr/${encodeURIComponent(img.IMG_NAME)}`;
      image.src = imagePath;
      image.alt = `Historical document: ${img.IMG_NAME}`;

      image.onload = () => drawBoxes(lines);
      if (image.complete && image.naturalWidth) {
        drawBoxes(lines);  // already cached, fire immediately
      }
    } else {
      // Same image, different model: draw immediately
      drawBoxes(lines);
    }
  }

  function onImageChange() {
    const imageId = pageSelect.value;
    populateDetectorSelect(imageId);
    populateRecognizerSelect(imageId, detectorSelect.value);
    render();
  }

  function onDetectorChange() {
    const imageId = pageSelect.value;
    populateRecognizerSelect(imageId, detectorSelect.value);
    render();
  }

  pageSelect.addEventListener('change', onImageChange);
  detectorSelect.addEventListener('change', onDetectorChange);
  recognizerSelect.addEventListener('change', render);
  showBoxes.addEventListener('change', render);

  // Initial load
  if (imageIds.length > 0) {
    pageSelect.value = imageIds[0];
    populateDetectorSelect(imageIds[0]);
    if (detectorSelect.options.length > 0) {
      detectorSelect.value = detectorSelect.options[0].value;
      populateRecognizerSelect(imageIds[0], detectorSelect.value);
      if (recognizerSelect.options.length > 0) {
        recognizerSelect.value = recognizerSelect.options[0].value;
      }
    }
    render();
  }
</script>