---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.js';

const title = 'Vision Hub – Welcome';
const description = 'Explore real-time computer vision demos built at LTU.';
---

<SiteLayout {title} {description}>

  <section class="hero hero-split">
    <div class="hero-left">
      <img
        src="/images/LTU_logo_ML.png"
        alt="Luleå University of Technology"
        class="hero-logo-big"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="hero-right">
      <h1 class="hero-h1">Vision Hub</h1>

      <p class="hero-sub">
        Explore interactive computer vision demos in real time — object detection, pose estimation, and more.
        Open a project to learn what it does, who built it, and try the live demo in one click.
      </p>

      <p class="hero-meta">
        Developed for Luleå University of Technology (LTU).
      </p>

      <div class="hero-cta">
        <a href="/projects" class="cta">Browse all projects</a>
        <a href="/docs" class="cta secondary">Read the docs</a>
      </div>
    </div>
  </section>

  <section class="projects-preview" aria-label="Project previews">
    {projects.map(p => (
      <ProjectCard
        image={p.image}
        title={p.title}
        description={p.description}
        credit={p.credit}
        href={`/projects/${p.slug}`}
      />
    ))}
  </section>

  <style>
    /* ===== HERO SPLIT (big LTU logo left, text right) ===== */
    .hero.hero-split{
      display: grid;
      grid-template-columns: minmax(220px, 420px) 1fr;
      gap: 28px;
      align-items: center;
      text-align: left;
    }

    /* Left column: big logo */
    .hero-left{
      display:flex;
      justify-content: center;
      align-items: center;
    }

    .hero-logo-big{
      width: 100%;
      max-width: 420px;   /* logo “en gros” */
      height: auto;
      object-fit: contain;

      border-radius: 18px;
      box-shadow: 0 10px 30px #0006;
      background: #fff;
      padding: 18px;
    }

    /* Right column: keep your existing text styles */
    .hero-right{
      display:flex;
      flex-direction: column;
      align-items: flex-start;
    }

    /* Optional: avoid centered hero styles from parent */
    .hero-h1{
      margin: 0 0 10px 0;
    }

    /* Your existing styles still apply */
    .hero-sub{
      margin: 0;
      max-width: 58ch;
      color: #cfe0ff;
      font-size: 1.05rem;
      line-height: 1.55;
    }

    .hero-meta{
      margin: 10px 0 0 0;
      font-size: .92rem;
      color: #9cb0d8;
      opacity: .95;
    }

    .hero-cta{
      display:flex;
      gap: 12px;
      justify-content:flex-start;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    /* secondary button */
    .cta.secondary{
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .cta.secondary:hover{
      background: #17203a;
    }

    /* Mobile: stack + center */
    @media (max-width: 820px) {
      .hero.hero-split{
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hero-right{
        align-items: center;
      }
      .hero-cta{
        justify-content: center;
      }
      .hero-logo-big{
        max-width: 280px;
        padding: 14px;
      }
    }


    /* optional secondary button style (keeps your main .cta) */
    .cta.secondary{
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .cta.secondary:hover{
      background: #17203a;
    }

    /* ===== PROJECT GRID ===== */
    .projects-preview {
      display: grid;
      gap: 48px;
      grid-template-columns: repeat(2, minmax(280px, 380px));
      justify-content: center;
      margin: 48px auto 0;
      padding: 0 16px;
    }
    @media (max-width: 820px) {
      .projects-preview {
        grid-template-columns: 1fr;
        justify-content: stretch;
      }
    }
  </style>
</SiteLayout>
