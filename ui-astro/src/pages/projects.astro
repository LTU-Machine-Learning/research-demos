---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.js';

const title = 'Vision Hub – Projects';
const description = 'Browse all real-time AI demos';
---

<SiteLayout {title} {description}>
  <div class="projects-wrap">
    <div class="projects-header">
      <a href="/" class="back-link">← Back to main menu</a>
    </div>

    <h1 class="projects-title">Vision Hub Projects</h1>

    <div class="projects-grid">
      {projects.map(p => (
        <ProjectCard
          image={p.image}
          title={p.title}
          description={p.description}
          href={`/projects/${p.slug}`}
        />
      ))}
    </div>
  </div>

  <style>
    body {
      margin: 0;
      background: linear-gradient(135deg, #0b0d12 0%, #1a2236 100%);
      color: #e8eefc;
      font: 18px/1.6 system-ui, Segoe UI, Roboto, Arial;
    }

    .projects-wrap {
      max-width: 1200px;
      margin: 48px auto 0;
      padding: 0 16px 48px;
    }

    .projects-header {
      text-align: center;
      margin-bottom: 18px;
    }

    .projects-title {
      text-align: center;
      font-size: 2.2rem;
      margin: 0 0 32px;
      letter-spacing: -1px;
    }

    .projects-grid {
      display: grid;
      gap: 32px;

      grid-template-columns: repeat(3, minmax(260px, 380px));

      justify-content: center;
    }

    @media (max-width: 760px) {
      .projects-grid {
        grid-template-columns: 1fr;
        justify-content: stretch;
      }
    }
    
    .back-link {
      display: inline-block;
      padding: 10px 28px;
      background: #132342;
      color: #5aa4ff;
      font-weight: 600;
      font-size: 1.1rem;
      border-radius: 14px;
      text-decoration: none;
      box-shadow: 0 2px 12px #0002;
      transition: background .18s ease, color .18s ease;
    }

    .back-link:hover {
      background: #1a2b54;
      color: #27d07d;
    }
  </style>
</SiteLayout>
