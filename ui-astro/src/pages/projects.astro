---
import projects from '../data/projects.js';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Vision Hub – Projects</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
  </head>
  <body>
    <style>
      body {
        margin: 0;
        background: linear-gradient(135deg, #0b0d12 0%, #1a2236 100%);
        color: #e8eefc;
        font: 18px/1.6 system-ui, Segoe UI, Roboto, Arial;
      }
      .projects-wrap {
        max-width: 1200px;
        margin: 48px auto 0 auto;
        padding: 0 16px 48px 16px;
      }
      .projects-title {
        text-align: center;
        font-size: 2.2rem;
        margin: 0 0 24px 0;
        letter-spacing: -1px;
      }
      .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 32px;
        margin-bottom: 32px;
      }
      .project-card {
        background: #181c28;
        border-radius: 18px;
        box-shadow: 0 4px 24px #0004;
        padding: 22px 18px 18px 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 0;
        transition: box-shadow .18s, transform .18s;
      }
      .project-card:hover {
        box-shadow: 0 8px 32px #0007;
        transform: translateY(-4px) scale(1.02);
      }
      .project-card img {
        width: 100%;
        max-width: 340px;
        border-radius: 14px;
        margin-bottom: 12px;
        box-shadow: 0 2px 12px #0003;
      }
      .project-card h2 {
        font-size: 1.25rem;
        margin: 8px 0 4px 0;
        color: #5aa4ff;
        text-align: center;
      }
      .project-card p {
        font-size: 1rem;
        color: #b0bedc;
        text-align: center;
        margin-bottom: 10px;
      }
      .project-card a {
        color: #27d07d;
        font-weight: bold;
        text-decoration: none;
        margin-top: 10px;
        font-size: 1.08rem;
        transition: color .18s;
      }
      .project-card a:hover {
        color: #5aa4ff;
        text-decoration: underline;
      }
    </style>
    <div class="projects-wrap">
      <div style="text-align:center;margin-bottom:18px;">
        <a href="/" style="display:inline-block;padding:10px 28px;background:#132342;color:#5aa4ff;font-weight:600;font-size:1.1rem;border-radius:14px;text-decoration:none;box-shadow:0 2px 12px #0002;transition:background .18s, color .18s;">← Back to main menu</a>
      </div>
      <h1 class="projects-title">Vision Hub Projects</h1>
      <div class="projects-grid">
        {projects.map(p => (
          <div class="project-card">
            <img src={p.image} alt={p.title} />
            <h2>{p.title}</h2>
            <p>{p.description}</p>
            <a href={"/projects/" + p.slug}>See details & demo →</a>
          </div>
        ))}
      </div>
    </div>
  </body>
</html>
